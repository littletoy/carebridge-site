            </a>
            
            <a href={whatsappLink} class="block bg-white border hover:border-rose-300 group rounded-2xl md:rounded-3xl p-6 md:p-8 text-center transition-all hover:-translate-y-1 shadow-sm hover:shadow-xl cursor-pointer">
               <div class="mx-auto w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-rose-500 to-pink-400 rounded-2xl flex items-center justify-center text-3xl md:text-5xl mb-4 md:mb-6">🎗️</div>
               <div class="font-bold text-lg md:text-xl">Oncology<br class="md:hidden"/> & Cancer</div>
            </a>
            
            <a href={whatsappLink} class="block bg-white border hover:border-cyan-300 group rounded-2xl md:rounded-3xl p-6 md:p-8 text-center transition-all hover:-translate-y-1 shadow-sm hover:shadow-xl cursor-pointer">
              <div class="mx-auto w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-blue-500 to-cyan-400 rounded-2xl flex items-center justify-center text-3xl md:text-5xl mb-4 md:mb-6">❤️</div>
              <div class="font-bold text-lg md:text-xl">Cardiology<br class="md:hidden"/> & CTVS</div>
            </a>
            
            <a href={whatsappLink} class="block bg-white border hover:border-teal-300 group rounded-2xl md:rounded-3xl p-6 md:p-8 text-center transition-all hover:-translate-y-1 shadow-sm hover:shadow-xl cursor-pointer">
              <div class="mx-auto w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-teal-500 to-emerald-400 rounded-2xl flex items-center justify-center text-3xl md:text-5xl mb-4 md:mb-6">🧠</div>
              <div class="font-bold text-lg md:text-xl">Neurology<br class="md:hidden"/> & Spine</div>
            </a>

            <a href={whatsappLink} class="block bg-white border hover:border-purple-300 group rounded-2xl md:rounded-3xl p-6 md:p-8 text-center transition-all hover:-translate-y-1 shadow-sm hover:shadow-xl cursor-pointer">
              <div class="mx-auto w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-purple-500 to-indigo-400 rounded-2xl flex items-center justify-center text-3xl md:text-5xl mb-4 md:mb-6">🩺</div>
              <div class="font-bold text-lg md:text-xl">Gastro-<br class="md:hidden"/>enterology</div>
            </a>

            <a href={whatsappLink} class="block bg-white border hover:border-blue-300 group rounded-2xl md:rounded-3xl p-6 md:p-8 text-center transition-all hover:-translate-y-1 shadow-sm hover:shadow-xl cursor-pointer">
              <div class="mx-auto w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-blue-400 to-indigo-500 rounded-2xl flex items-center justify-center text-3xl md:text-5xl mb-4 md:mb-6">💧</div>
              <div class="font-bold text-lg md:text-xl">Urology &<br class="md:hidden"/> Nephrology</div>
            </a>

            <a href={whatsappLink} class="block bg-white border hover:border-orange-300 group rounded-2xl md:rounded-3xl p-6 md:p-8 text-center transition-all hover:-translate-y-1 shadow-sm hover:shadow-xl cursor-pointer">
              <div class="mx-auto w-16 h-16 md:w-20 md:h-20 bg-gradient-to-br from-orange-400 to-red-400 rounded-2xl flex items-center justify-center text-3xl md:text-5xl mb-4 md:mb-6">🫁</div>
              <div class="font-bold text-lg md:text-xl">Organ<br class="md:hidden"/> Transplant</div>
            </a>

            <a href={whatsappLink} class="block bg-white border hover:border-pink-300 group rounded-2xl md:rounded-3xl p-6 md:p-8 text-center transition-all hover:-translate-y-1 shadow-sm hover:shadow-xl cursor-pointer">
