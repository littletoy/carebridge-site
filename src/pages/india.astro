---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";

// UPDATED: Custom message so your team knows this is a Domestic Lead from the Ads
const whatsappLink = "https://wa.me/919840653616?text=Hi%20CareBridge%2C%20I%20saw%20your%20ad%20and%20would%20like%20to%20get%20a%20priority%20appointment%20or%20surgery%20cost%20estimate.";
---

<Layout title="CareBridge Health • Premium Hospital Network & Priority Appointments">
  <Container>
    <div class="relative isolate overflow-hidden bg-slate-50">
      <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute inset-x-0 top-0 h-[900px] bg-gradient-to-br from-blue-500/15 via-cyan-400/25 to-violet-500/15 blur-3xl"></div>
        <div class="absolute -left-60 top-32 h-[520px] w-[520px] rounded-full bg-gradient-to-br from-cyan-400/40 to-blue-600/30 blur-[140px]"></div>
        <div class="absolute -right-60 top-[420px] h-[520px] w-[520px] rounded-full bg-gradient-to-br from-violet-400/40 to-indigo-600/30 blur-[140px]"></div>
        <div class="absolute bottom-20 left-1/2 h-96 w-96 rounded-full bg-gradient-to-br from-emerald-400/30 to-teal-500/30 blur-[110px]"></div>
      </div>

      <section class="min-h-screen pt-28 pb-16 md:pt-32 md:pb-20 flex items-center relative overflow-hidden">
