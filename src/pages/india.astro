          <div class="lg:col-span-7 pt-10 md:pt-0">
            <div class="inline-flex items-center gap-2 md:gap-3 px-4 md:px-8 py-2 md:py-3 bg-white/95 backdrop-blur-2xl rounded-full border border-white shadow-2xl mb-6 md:mb-8">
              <span class="text-emerald-500 text-lg md:text-xl">🏆</span>
              <span class="font-bold text-emerald-700 tracking-[1px] md:tracking-[1.5px] uppercase text-xs md:text-sm">Official Partner of Manipal Hospitals</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-7xl xl:text-[82px] font-black leading-[1.1] md:leading-[1.05] tracking-tight text-slate-950">
              India's Best Surgeons.<br>
              <span class="bg-gradient-to-r from-blue-700 via-cyan-600 to-violet-600 bg-clip-text text-transparent">Without the Wait.</span>
            </h1>

            <p class="mt-6 md:mt-8 max-w-2xl text-lg md:text-2xl text-slate-600 font-light">
              Skip the hospital queues. We connect patients to elite JCI-accredited specialists in Bangalore and your city—delivering priority appointments, exact cost estimates, and VIP coordination.
            </p>

            <div class="mt-10 md:mt-16 relative">
              
              <div class="absolute -inset-1 bg-green-500/30 rounded-full blur-xl opacity-75 group-hover:opacity-100 animate-pulse z-0"></div>

              <div class="flex flex-col md:flex-row gap-6 md:gap-8 relative z-10 items-center">
                
                <a href={whatsappLink}
                   class="group/btn relative inline-flex items-center justify-center gap-4 md:gap-5 
                          bg-green-500 hover:bg-green-600 text-white font-black text-2xl md:text-3xl 
                          py-7 md:py-10 px-10 md:px-16 rounded-full md:rounded-3xl
                          transition-all duration-300
                          shadow-[0_15px_60px_-10px_rgba(16,185,129,0.7)] 
                          hover:shadow-[0_25px_80px_-10px_rgba(16,185,129,0.9)] 
                          hover:scale-[1.05] active:scale-[0.98]
                          animate-wiggle-on-load overflow-hidden">
                  
                  <div class="absolute inset-0 h-full w-full -translate-x-full group-hover/btn:animate-sheen rounded-[inherit] bg-gradient-to-r from-transparent via-white/30 to-transparent z-0"></div>

                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="w-9 h-9 md:w-11 md:h-11 fill-current relative z-10 -mt-1"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.588-5.946 0-6.56 5.338-11.891 11.893-11.891 3.181 0 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.481 8.403 0 6.561-5.338 11.892-11.893 11.892-1.99 0-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.591 5.468 0 9.913-4.445 9.913-9.913 0-5.468-4.445-9.913-9.913-9.913-5.466 0-9.913 4.447-9.913 9.913 0 2.136.6 3.73 1.594 5.394l-.908 3.323 3.335-.874zm7.951-11.94c.123-.183.334-.73.522-1.24.188-.509.335-.908.441-1.12.106-.211.33-.302.498-.313.117-.008.232.008.337.042.106.035.215.111.314.19.1.079.162.152.203.224.041.071.078.143.102.21.025.066.046.126.06.177.014.051.02.102.016.146-.003.045-.018.117-.063.266-.046.149-.244.757-.591 1.706-.346.949-.696 1.832-.887 2.234l-.089.183c-.09.184-.251.315-.429.352-.178.038-.367-.015-.503-.122-.137-.107-.22-.266-.231-.444-.01-.178.053-.365.176-.523zm-3.321 3.242c.117-.189.3-.312.518-.328.218-.016.425.061.571.219.146.157.208.373.18.591-.027.218-.157.397-.361.503l-.161.082c-.104.053-.217.111-.328.175l-.264.153c-.11.064-.202.128-.276.192l-.123.111c-.083.076-.145.143-.186.2l-.053.071c-.053.071-.088.111-.105.111.018-.142.158-.804.316-1.509.158-.704.302-1.26.432-1.579zm6.632-1.229l.138.169c.1.123.155.281.151.444-.004.162-.064.315-.171.439l-.396.452c-.1.115-.152.261-.151.41.002.149.062.291.168.397l.142.141c.106.106.248.167.398.168.15.002.296-.05.397-.152l.288-.291.138-.139c.106-.106.248-.168.398-.168.15.001.296.06.397.168l.141.141c.106.106.166.248.168.397.001.15-.05.296-.151.397l-.291.288-.352.348c-.106.106-.166.248-.168.397-.001.15.05.296.151.397l.141.141c.106.106.248.168.398.168.15.002.296-.06.397-.168l.139-.141c.106-.106.166-.248.168-.397.001-.15-.05-.296-.151-.397l-.288-.291-.351-.349zm-8.823 4.606l.338.257c-.126.17-.323.277-.542.277-.383 0-.693-.31-.693-.693 0-.106.024-.206.066-.296l-.16-.121-.115.152.091.069c.075.057.126.136.143.226h-.285l.115-.152-.091-.069c-.066-.05-.15-.077-.235-.077-.102 0-.201.037-.282.106l-.115.152.091.069c.066.05.15.077.235.077.102 0 .201-.037.282-.106l.115-.152.091.069zm-2.071-.876l.115-.152-.091-.069c-.066-.05-.15-.077-.235-.077-.102 0-.201.037-.282.106l-.115.152.091.069c.066.05.15.077.235.077.102 0 .201-.037.282-.106l.115-.152-.091-.069c-.066-.05-.15-.077-.235-.077-.102 0-.201.037-.282.106l-.115.152.091.069c.066.05.15.077.235.077.102 0 .201-.037.282-.106l.115-.152.091.069zm6.756 1.152l.138.169c.1.123.155.281.151.444-.004.162-.064.315-.171.439l-.396.452c-.1.115-.152.261-.151.41.002.149.062.291.168.397l.142.141c.106.106.248.167.398.168.15.002.296-.05.397-.152l.288-.291.138-.139c.106-.106.248-.168.398-.168.15.001.296.06.397.168l.141.141c.106.106.166.248.168.397.001.15-.05.296-.151.397l-.291.288-.352.348c-.106.106-.166.248-.168.397-.001.15.05.296.151.397l.141.141c.106.106.248.168.398.168.15.002.296-.06.397-.168l.139-.141c.106-.106.166-.248.168-.397.001-.15-.05-.296-.151-.397l-.288-.291-.351-.349z"/></svg>
                  
