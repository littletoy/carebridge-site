---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";

const whatsappLink = "https://wa.me/919994581853?text=Hi%20CareBridge%2C%20I%27m%20interested%20in%20premium%20treatment%20in%20India";
---

<Layout title="CareBridge Health • Luxury Medical Tourism in India | Official Manipal Partner">
  <Container>
    <!-- LUXURY FULL-PAGE GLOW WRAPPER -->
    <div class="relative isolate overflow-hidden">
      <!-- Master Background Glows -->
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-x-0 top-0 h-[800px] bg-gradient-to-br from-blue-400/20 via-cyan-300/30 to-indigo-400/20 blur-3xl"></div>
        <div class="absolute -left-40 top-40 h-96 w-96 rounded-full bg-gradient-to-br from-cyan-300 to-blue-400 opacity-30 blur-[120px]"></div>
        <div class="absolute -right-40 top-[28rem] h-96 w-96 rounded-full bg-gradient-to-br from-indigo-300 to-purple-400 opacity-30 blur-[120px]"></div>
        <div class="absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-gradient-to-br from-emerald-300 to-teal-400 opacity-20 blur-[100px]"></div>
      </div>

      <!-- HERO – Ultra Premium -->
      <section class="min-h-screen pt-20 lg:pt-28 pb-20 flex items-center relative">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-16 items-center px-6">
          <!-- Left Content -->
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-3 px-6 py-2.5 bg-white/90 backdrop-blur-xl rounded-3xl border border-white/70 shadow-xl mb-8">
              <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
              <span class="text-emerald-700 text-sm font-bold tracking-[2px] uppercase">Official International Partner of Manipal Hospitals</span>
            </div>

            <h1 class="text-6xl lg:text-7xl xl:text-8xl font-black leading-none text-slate-950 tracking-tighter">
              World-Class Care.<br>
              <span class="bg-gradient-to-r from-blue-600 via-cyan-500 to-violet-600 bg-clip-text text-transparent">Zero Wait. Pure Luxury.</span>
            </h1>

            <p class="mt-8 text-2xl text-slate-600 max-w-2xl">
              Premium medical tourism in India for discerning international patients.<br>
              <span class="font-semibold text-slate-700">Visa • Flights • 5-Star Stay • VIP Hospital Access</span>
            </p>

            <!-- Dual Premium CTAs -->
            <div class="mt-10 flex flex-col sm:flex-row gap-5">
              <a href={whatsappLink}
                 class="group flex-1 sm:flex-none bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-bold text-xl py-7 px-12 rounded-3xl flex items-center justify-center gap-4 shadow-2xl shadow-emerald-500/50 transition-all duration-500 hover:scale-105 hover:shadow-emerald-600/60">
                <span>Chat on WhatsApp Now</span>
                <span class="text-3xl group-hover:rotate-12 transition">💬</span>
              </a>

              <a href="#journey" 
                 class="flex-1 sm:flex-none border-2 border-slate-900 hover:bg-slate-900 hover:text-white font-semibold text-xl py-7 px-12 rounded-3xl text-center transition-all duration-300">
                See the Luxury Journey →
              </a>
            </div>

            <!-- Trust Bar -->
            <div class="mt-16 flex flex-wrap items-center gap-x-10 gap-y-6 text-sm">
              <div class="flex items-center gap-3">
                <div class="text-4xl">🇺🇸🇬🇧🇦🇪🇳🇬</div>
                <div>
                  <div class="font-bold text-slate-900">Patients from 47 countries</div>
                  <div class="text-slate-500 text-xs">Last month alone</div>
                </div>
              </div>
              <div class="h-9 w-px bg-slate-200"></div>
              <div class="flex items-center gap-4">
                <div class="flex -space-x-4">
                  <div class="w-9 h-9 rounded-2xl bg-white border-2 border-white shadow ring-2 ring-emerald-200 overflow-hidden"><img src="https://picsum.photos/id/64/64" class="object-cover"></div>
                  <div class="w-9 h-9 rounded-2xl bg-white border-2 border-white shadow ring-2 ring-emerald-200 overflow-hidden"><img src="https://picsum.photos/id/201/64" class="object-cover"></div>
                </div>
                <div class="text-xs leading-tight">
                  <div class="font-bold text-emerald-600">4.98/5</div>
                  <div class="text-slate-500">from 1,284 verified patients</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Hero Visual -->
          <div class="lg:col-span-5 relative">
            <div class="relative rounded-[3rem] overflow-hidden shadow-2xl ring-1 ring-white/50">
              <img 
                src="/VmJrama5RuC2UkdwRtPMgn7DStLjdCvzR2JKGBzr.avif"
                alt="Manipal Hospitals Luxury Care"
                class="w-full aspect-[4/3] object-cover scale-110 hover:scale-100 transition-transform duration-700"
              >
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
              
              <!-- Floating Premium Badge -->
              <div class="absolute top-8 right-8 bg-white/95 backdrop-blur-3xl px-7 py-4 rounded-3xl shadow-2xl border border-white">
                <div class="flex items-center gap-3">
                  <div class="text-5xl">🏆</div>
                  <div>
                    <div class="font-black text-2xl text-slate-900 leading-none">Manipal</div>
                    <div class="text-emerald-600 text-sm font-bold tracking-widest">EXCLUSIVE PARTNER</div>
                  </div>
                </div>
              </div>

              <!-- Mini Stats Floating -->
              <div class="absolute bottom-8 left-8 bg-white/95 backdrop-blur-3xl rounded-3xl p-6 shadow-2xl grid grid-cols-3 gap-6 text-center">
                <div>
                  <div class="text-3xl font-black text-cyan-600">72h</div>
                  <div class="text-xs tracking-widest text-slate-500">Average response</div>
                </div>
                <div>
                  <div class="text-3xl font-black text-violet-600">98%</div>
                  <div class="text-xs tracking-widest text-slate-500">Success rate</div>
                </div>
                <div>
                  <div class="text-3xl font-black text-emerald-600">VIP</div>
                  <div class="text-xs tracking-widest text-slate-500">Concierge</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- WHY CAREBRIDGE – Luxury Cards -->
      <section class="py-24 bg-white/70 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-16">
            <div class="inline text-xs font-black tracking-[4px] text-cyan-600">WHY GLOBAL PATIENTS CHOOSE US</div>
            <h2 class="text-5xl font-bold text-slate-900 mt-3">Luxury Medical Concierge</h2>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="group bg-gradient-to-br from-white to-cyan-50 border border-cyan-100 rounded-3xl p-10 hover:-translate-y-3 hover:shadow-2xl transition-all duration-500">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-500 flex items-center justify-center text-4xl mb-8">📋</div>
              <h3 class="text-2xl font-bold">Instant File Review</h3>
              <p class="mt-4 text-slate-600">Send scans on WhatsApp. AI + expert doctors review in hours — not weeks.</p>
            </div>
            <div class="group bg-gradient-to-br from-white to-violet-50 border border-violet-100 rounded-3xl p-10 hover:-translate-y-3 hover:shadow-2xl transition-all duration-500">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-violet-500 to-purple-500 flex items-center justify-center text-4xl mb-8">🏥</div>
              <h3 class="text-2xl font-bold">Elite Hospital Matching</h3>
              <p class="mt-4 text-slate-600">Personalized matching with Manipal & India’s top JCI-accredited centers.</p>
            </div>
            <div class="group bg-gradient-to-br from-white to-emerald-50 border border-emerald-100 rounded-3xl p-10 hover:-translate-y-3 hover:shadow-2xl transition-all duration-500">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center text-4xl mb-8">✈️</div>
              <h3 class="text-2xl font-bold">White-Glove Travel</h3>
              <p class="mt-4 text-slate-600">Medical visa, business-class flights, airport Rolls-Royce pickup, 5-star hotels.</p>
            </div>
            <div class="group bg-gradient-to-br from-white to-rose-50 border border-rose-100 rounded-3xl p-10 hover:-translate-y-3 hover:shadow-2xl transition-all duration-500">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-rose-500 to-pink-500 flex items-center justify-center text-4xl mb-8">🤖</div>
              <h3 class="text-2xl font-bold">Sarah — Your AI Angel</h3>
              <p class="mt-4 text-slate-600">24/7 WhatsApp concierge that never sleeps. Real human backup always ready.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- MANIPAL PARTNERSHIP – Ultra Luxe -->
      <section class="py-24">
        <div class="max-w-6xl mx-auto px-6">
          <div class="bg-gradient-to-br from-slate-900 to-zinc-900 rounded-[3rem] overflow-hidden shadow-2xl relative">
            <!-- Glow accents -->
            <div class="absolute -top-20 -right-20 w-96 h-96 bg-cyan-400/10 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-20 -left-20 w-96 h-96 bg-violet-400/10 rounded-full blur-3xl"></div>

            <div class="grid lg:grid-cols-2">
              <div class="p-16 lg:p-20 flex flex-col justify-center">
                <div class="uppercase text-emerald-400 text-sm font-bold tracking-[3px]">OFFICIAL GLOBAL PARTNER</div>
                <h2 class="text-white text-5xl leading-none font-bold mt-6">Manipal Hospitals<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-violet-300">Exclusively for You</span></h2>
                <p class="text-slate-400 mt-8 text-lg">Faster appointments. Dedicated international wing. Priority operating theatres. Personal care managers.</p>
                
                <div class="mt-12 space-y-6 text-slate-300">
                  <div class="flex gap-6"><span class="text-emerald-400 text-2xl">✓</span> <span>Priority slots within 48 hrs</span></div>
                  <div class="flex gap-6"><span class="text-emerald-400 text-2xl">✓</span> <span>English-speaking care team</span></div>
                  <div class="flex gap-6"><span class="text-emerald-400 text-2xl">✓</span> <span>Seamless insurance & billing</span></div>
                </div>
              </div>
              <div class="relative">
                <img src="/VmJrama5RuC2UkdwRtPMgn7DStLjdCvzR2JKGBzr.avif" class="h-full w-full object-cover" alt="Manipal Luxury Wing">
                <div class="absolute inset-0 bg-gradient-to-r from-slate-900/80 to-transparent"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CENTERS OF EXCELLENCE – Vibrant Grid -->
      <section class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-16">
            <span class="px-6 py-2 bg-gradient-to-r from-violet-100 to-cyan-100 rounded-full text-sm font-bold text-violet-700">WORLD-RENOWNED SPECIALTIES</span>
            <h2 class="text-5xl font-bold mt-4">Centers of Excellence</h2>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
            <div class="bg-white border border-slate-100 hover:border-cyan-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-2 hover:shadow-xl">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-blue-500 to-cyan-400 rounded-2xl flex items-center justify-center text-5xl mb-6 group-hover:scale-110 transition">👨‍🦲</div>
              <div class="font-bold text-xl">Hair & Dental</div>
            </div>
            <div class="bg-white border border-slate-100 hover:border-rose-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-2 hover:shadow-xl">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-rose-500 to-pink-400 rounded-2xl flex items-center justify-center text-5xl mb-6 group-hover:scale-110 transition">🎗️</div>
              <div class="font-bold text-xl">Oncology</div>
            </div>
            <div class="bg-white border border-slate-100 hover:border-red-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-2 hover:shadow-xl">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-red-500 to-orange-400 rounded-2xl flex items-center justify-center text-5xl mb-6 group-hover:scale-110 transition">❤️</div>
              <div class="font-bold text-xl">Cardiology</div>
            </div>
            <div class="bg-white border border-slate-100 hover:border-amber-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-2 hover:shadow-xl">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-amber-500 to-yellow-400 rounded-2xl flex items-center justify-center text-5xl mb-6 group-hover:scale-110 transition">🦴</div>
              <div class="font-bold text-xl">Orthopedics</div>
            </div>
            <div class="bg-white border border-slate-100 hover:border-purple-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-2 hover:shadow-xl">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-purple-500 to-violet-400 rounded-2xl flex items-center justify-center text-5xl mb-6 group-hover:scale-110 transition">👶</div>
              <div class="font-bold text-xl">IVF & Fertility</div>
            </div>
            <div class="bg-white border border-slate-100 hover:border-teal-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-2 hover:shadow-xl">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-teal-500 to-cyan-400 rounded-2xl flex items-center justify-center text-5xl mb-6 group-hover:scale-110 transition">🧠</div>
              <div class="font-bold text-xl">Neurology</div>
            </div>
          </div>
        </div>
      </section>

      <!-- JOURNEY / HOW IT WORKS -->
      <section id="journey" class="py-28 bg-gradient-to-b from-slate-50 to-white">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-5xl font-bold">Your 5-Star Journey</h2>
            <p class="text-slate-500 mt-4 text-xl">From first message to flying home healed</p>
          </div>

          <div class="grid md:grid-cols-5 gap-6 relative">
            <div class="bg-white rounded-3xl p-10 shadow-xl relative z-10">
              <div class="text-cyan-500 font-mono text-6xl font-black opacity-10 absolute -top-6 right-6">01</div>
              <div class="text-2xl font-bold">Share Reports</div>
              <div class="mt-6 text-slate-600">WhatsApp your documents. Sarah organises everything instantly.</div>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl relative z-10">
              <div class="text-cyan-500 font-mono text-6xl font-black opacity-10 absolute -top-6 right-6">02</div>
              <div class="text-2xl font-bold">Expert Matching</div>
              <div class="mt-6 text-slate-600">Top doctors review & quote within 24 hrs.</div>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl relative z-10">
              <div class="text-cyan-500 font-mono text-6xl font-black opacity-10 absolute -top-6 right-6">03</div>
              <div class="text-2xl font-bold">Visa & Travel</div>
              <div class="mt-6 text-slate-600">We arrange everything — invitation letter to luxury transfer.</div>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl relative z-10">
              <div class="text-cyan-500 font-mono text-6xl font-black opacity-10 absolute -top-6 right-6">04</div>
              <div class="text-2xl font-bold">Treatment</div>
              <div class="mt-6 text-slate-600">VIP hospital experience with personal coordinator.</div>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl relative z-10">
              <div class="text-cyan-500 font-mono text-6xl font-black opacity-10 absolute -top-6 right-6">05</div>
              <div class="text-2xl font-bold">Return Home</div>
              <div class="mt-6 text-slate-600">Post-treatment support for 90 days included.</div>
            </div>
          </div>
        </div>
      </section>

      <!-- SARAH AI – Futuristic Neon -->
      <section class="py-28 relative">
        <div class="max-w-5xl mx-auto bg-gradient-to-br from-zinc-950 via-slate-900 to-black rounded-[3rem] p-16 text-white relative overflow-hidden">
          <div class="absolute inset-0 bg-[radial-gradient(at_50%_30%,rgba(59,130,246,0.15),transparent)]"></div>
          
          <div class="grid md:grid-cols-2 gap-16 items-center">
            <div>
              <div class="flex items-center gap-4 mb-8">
                <div class="w-20 h-20 rounded-3xl bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center text-5xl">🤖</div>
                <div>
                  <div class="text-emerald-400 font-bold tracking-widest">AI MEETS HUMAN CARE</div>
                  <h2 class="text-5xl font-bold leading-none mt-2">Meet Sarah,<br>Your 24/7 Medical Angel</h2>
                </div>
              </div>
              <p class="text-xl text-slate-300">She speaks 12 languages, understands medical reports, books your appointments, and never lets you feel alone.</p>
              
              <a href={whatsappLink} class="mt-12 inline-flex items-center gap-4 bg-white text-black font-bold text-xl px-10 py-6 rounded-3xl hover:bg-emerald-400 hover:text-white transition-all">
                Message Sarah Now <span class="text-3xl">→</span>
              </a>
            </div>

            <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-8">
              <div class="space-y-6 text-sm">
                <div class="bg-white/10 p-5 rounded-2xl">Hi Sarah, I need knee replacement. Here are my MRI scans.</div>
                <div class="bg-gradient-to-r from-cyan-400/20 to-blue-400/20 p-5 rounded-2xl ml-auto max-w-[80%]">Thank you! I’ve reviewed your scans. Dr. Rao at Manipal can see you next week. Shall I book the VIP package?</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TRAVEL CONCIERGE -->
      <section class="py-28 bg-gradient-to-br from-cyan-50 to-white">
        <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-5xl font-bold leading-tight">From Your Doorstep<br>to India’s Finest Hospitals</h2>
            <ul class="mt-12 space-y-10">
              <li class="flex gap-8">
                <div class="text-6xl">🛂</div>
                <div>
                  <div class="font-bold text-2xl">Medical Visa in 72 hrs</div>
                  <p class="text-slate-600">We prepare & submit everything. You just sign.</p>
                </div>
              </li>
              <li class="flex gap-8">
                <div class="text-6xl">🏨</div>
                <div>
                  <div class="font-bold text-2xl">5-Star Recovery Stays</div>
                  <p class="text-slate-600">Taj, Oberoi, or serviced apartments near hospital.</p>
                </div>
              </li>
              <li class="flex gap-8">
                <div class="text-6xl">🚘</div>
                <div>
                  <div class="font-bold text-2xl">Private Airport Transfers</div>
                  <p class="text-slate-600">Mercedes / BMW with medical escort.</p>
                </div>
              </li>
            </ul>
          </div>
          
          <div class="relative rounded-3xl overflow-hidden bg-white shadow-2xl">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-400/10 to-transparent"></div>
            <img src="https://picsum.photos/id/1015/1200/800" class="w-full" alt="Luxury Travel">
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 p-10 text-white">
              <div class="uppercase text-xs tracking-widest text-emerald-400">YOUR JOURNEY STARTS HERE</div>
              <div class="text-3xl font-bold mt-2">One message.<br>Everything taken care of.</div>
            </div>
          </div>
        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="py-32 bg-gradient-to-r from-blue-700 via-violet-700 to-indigo-700 text-white">
        <div class="max-w-4xl mx-auto text-center px-6">
          <h2 class="text-6xl font-black leading-none">Ready for the best decision<br>of your health journey?</h2>
          <p class="mt-8 text-2xl opacity-90">Thousands of patients already healed in India with us.<br>Join them today.</p>
          
          <a href={whatsappLink}
             class="mt-12 inline-block bg-white text-slate-900 font-black text-3xl px-16 py-8 rounded-3xl hover:bg-emerald-400 hover:text-white transition-all shadow-2xl">
            Start Your VIP Journey on WhatsApp →
          </a>
          
          <div class="mt-10 text-xs opacity-70">Response within minutes • 100% confidential • No obligation</div>
        </div>
      </section>
    </div>
  </Container>
</Layout>