---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
---

<Layout title="Elite Hair Restoration | CareBridge Health">
  <Container>
    
    <div class="mt-16 text-center max-w-5xl mx-auto">
      <div class="inline-block bg-slate-900 text-yellow-400 text-xs font-bold px-4 py-1.5 rounded-full mb-6 uppercase tracking-wider border border-yellow-500/50">
        ✨ The Presidential Standard
      </div>
      <h1 class="text-5xl lg:text-6xl font-extrabold lg:tracking-tight text-slate-900 leading-tight">
        World-Class Hair Restoration.<br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-500">Unmatched Luxury.</span>
      </h1>
      <p class="text-lg mt-6 text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Experience India's most exclusive medical tourism service. 
        Surgery by <strong>AHRS Presidents</strong> & <strong>ISHRS Governors</strong> only. 
        <br>
        <span class="text-slate-400 text-sm mt-2 block">(Strictly No Technicians. No Compromises.)</span>
      </p>
      
      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-5">
        <a href="https://wa.me/919994581853?text=Hi%20CareBridge%2C%20I%20am%20interested%20in%20the%20VIP%20Package" 
           class="bg-gradient-to-r from-yellow-400 to-yellow-500 text-slate-900 px-8 py-4 rounded-xl font-bold text-lg hover:from-yellow-500 hover:to-yellow-600 transition flex items-center justify-center gap-2 shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Get Priority Quote</span>
        </a>
      </div>
    </div>

    <div class="mt-24 bg-slate-900 rounded-3xl p-8 md:p-12 text-center md:text-left relative overflow-hidden shadow-2xl">
      <div class="absolute top-0 right-0 w-64 h-64 bg-yellow-500 opacity-10 blur-3xl rounded-full pointer-events-none"></div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center relative z-10">
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Not Just a Surgery.<br><span class="text-yellow-400">A VIP Experience.</span></h2>
          <ul class="space-y-6">
            <li class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-yellow-400 text-xl border border-slate-700">🚘</div>
              <div>
                <strong class="text-white text-lg block">Chauffeur-Driven Transfer</strong>
                <p class="text-slate-400 text-sm">Private luxury car pickup from Delhi Airport directly to your hotel.</p>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-yellow-400 text-xl border border-slate-700">🏨</div>
              <div>
                <strong class="text-white text-lg block">5-Star Luxury Stay</strong>
                <p class="text-slate-400 text-sm">Relax in a premium room at The Radisson / Taj (Breakfast included).</p>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-yellow-400 text-xl border border-slate-700">🤵</div>
              <div>
                <strong class="text-white text-lg block">Personal Care Manager</strong>
                <p class="text-slate-400 text-sm">A dedicated CareBridge concierge is available to you 24/7 on WhatsApp.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="relative h-full min-h-[300px] rounded-xl overflow-hidden border border-slate-700">
           <img 
            src="https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=2070&auto=format&fit=crop" 
            alt="Luxury Hotel Interior" 
            class="absolute inset-0 w-full h-full object-cover opacity-80"
          />
          <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-slate-900 to-transparent p-6">
            <span class="text-white font-medium">Included in your package</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-24">
      <h2 class="text-3xl font-bold text-center mb-10">Premium Quality. Sensible Pricing.</h2>
      <div class="overflow-x-auto shadow-xl rounded-xl border border-slate-200">
        <table class="w-full text-left border-collapse bg-white">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="p-5 border-b border-slate-700">Treatment Level</th>
              <th class="p-5 border-b border-slate-700 text-slate-300">Dubai / UK Cost</th>
              <th class="p-5 border-b border-slate-700 bg-yellow-500 text-slate-900 font-bold border-l-4 border-l-yellow-200">CareBridge VIP</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-5 border-b font-medium text-slate-800">
                <strong>Premium FUE</strong> <br>
                <span class="text-xs text-slate-500">Includes 2500+ Grafts</span>
              </td>
              <td class="p-5 border-b text-red-500 font-medium">$10,000+</td>
              <td class="p-5 border-b font-bold text-slate-900 bg-yellow-50 border-l-4 border-l-yellow-500">
                $2,000 <span class="text-xs font-normal text-slate-600">(Approx)</span>
              </td>
            </tr>
            <tr>
              <td class="p-5 border-b font-medium text-slate-800">
                <strong>Executive DHI</strong> <br>
                <span class="text-xs text-slate-500">No-Shave Options Available</span>
              </td>
              <td class="p-5 border-b text-red-500 font-medium">$13,000+</td>
              <td class="p-5 border-b font-bold text-slate-900 bg-yellow-50 border-l-4 border-l-yellow-500">
                $3,000 <span class="text-xs font-normal text-slate-600">(Starting)</span>
              </td>
            </tr>
            <tr>
              <td class="p-5 border-b font-medium text-slate-800">
                <strong>Surgeon Tier</strong>
              </td>
              <td class="p-5 border-b text-slate-500">Technicians</td>
              <td class="p-5 border-b font-bold text-blue-800 bg-yellow-50 border-l-4 border-l-yellow-500">
                PRESIDENT / GOVERNOR
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-center text-xs text-slate-400 mt-4">
        *Final price depends on graft count and technique. We provide a fixed quote before you fly.
      </p>
    </div>

    <div class="mt-24 mb-20">
      <h2 class="text-3xl font-bold text-center mb-4">India's Most Elite Surgeons</h2>
      <p class="text-center text-slate-600 mb-12 max-w-2xl mx-auto">
        We refuse to work with generic clinics. You will be operated on by the leaders of the industry.
      </p>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        
        <div class="relative bg-white p-8 rounded-2xl border border-slate-200 shadow-xl hover:shadow-2xl transition transform hover:-translate-y-1 flex flex-col items-center">
          <div class="absolute top-0 right-0 bg-yellow-400 text-slate-900 text-xs font-bold px-4 py-2 rounded-bl-xl rounded-tr-xl tracking-wide">
            PRESIDENT, AHRS
          </div>
          <div class="w-28 h-28 bg-slate-100 rounded-full mb-6 overflow-hidden border-4 border-white shadow-md">
            <img src="/mayank.jpg" alt="Dr Mayank Singh" class="w-full h-full object-cover"/>
          </div>
          <h3 class="text-2xl font-bold text-center text-slate-900">Dr. Mayank Singh</h3>
          <p class="text-blue-600 text-sm font-bold text-center mb-6">Crown Clinic | New Delhi</p>
          <ul class="text-sm text-slate-600 space-y-3 mb-8 w-full text-left pl-4">
            <li class="flex gap-3"><span>🏆</span> <strong>President, AHRS India</strong></li>
            <li class="flex gap-3"><span>🇺🇸</span> Diplomate, ABHRS (USA)</li>
            <li class="flex gap-3"><span>✨</span> Celebrity & Repair Specialist</li>
          </ul>
          <a href="https://wa.me/919994581853?text=Hi%20CareBridge%2C%20I%20want%20a%20quote%20for%20Dr.%20Mayank" 
             class="block w-full py-4 bg-slate-900 text-white font-bold text-lg text-center rounded-xl hover:bg-slate-800 transition shadow-lg">
             Request Quote (Get a Quote)
          </a>
        </div>

        <div class="relative bg-white p-8 rounded-2xl border border-slate-200 shadow-xl hover:shadow-2xl transition transform hover:-translate-y-1 flex flex-col items-center">
          <div class="absolute top-0 right-0 bg-yellow-400 text-slate-900 text-xs font-bold px-4 py-2 rounded-bl-xl rounded-tr-xl tracking-wide">
            ISHRS GOVERNOR
          </div>
          <div class="w-28 h-28 bg-slate-100 rounded-full mb-6 overflow-hidden border-4 border-white shadow-md">
             <img src="/kapil.jpg" alt="Dr Kapil Dua" class="w-full h-full object-cover"/>
          </div>
          <h3 class="text-2xl font-bold text-center text-slate-900">Dr. Kapil Dua</h3>
          <p class="text-blue-600 text-sm font-bold text-center mb-6">AK Clinics | New Delhi</p>
          <ul class="text-sm text-slate-600 space-y-3 mb-8 w-full text-left pl-4">
            <li class="flex gap-3"><span>🌍</span> <strong>Board of Governors (ISHRS)</strong></li>
            <li class="flex gap-3"><span>🇺🇸</span> Diplomate, ABHRS (USA)</li>
            <li class="flex gap-3"><span>✨</span> World Record Holder (FUE)</li>
          </ul>
          <a href="https://wa.me/919994581853?text=Hi%20CareBridge%2C%20I%20want%20a%20quote%20for%20Dr.%20Kapil" 
             class="block w-full py-4 bg-slate-900 text-white font-bold text-lg text-center rounded-xl hover:bg-slate-800 transition shadow-lg">
             Request Quote (Get a Quote)
          </a>
        </div>

      </div>
    </div>
    
    <div class="mt-24">
      <h2 class="text-3xl font-bold text-center mb-4">Real Results. No Filters.</h2>
      <p class="text-center text-slate-600 mb-10">
        Results from our exclusive partner network.
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-100 hover:shadow-md transition">
          <div class="h-64 bg-slate-200 rounded-lg overflow-hidden relative">
            <span class="absolute bottom-2 right-2 bg-green-600 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">AFTER</span>
            <img src="/images/crown-1.jpg" alt="Hair Transplant Result 1" class="w-full h-full object-cover"/>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900 text-center">High Density Hairline</p>
        </div>
        <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-100 hover:shadow-md transition">
          <div class="h-64 bg-slate-200 rounded-lg overflow-hidden relative">
            <span class="absolute bottom-2 right-2 bg-green-600 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">AFTER</span>
            <img src="/images/crown-2.jpg" alt="Hair Transplant Result 2" class="w-full h-full object-cover"/>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900 text-center">Grade 4 Baldness Fixed</p>
        </div>
        <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-100 hover:shadow-md transition">
          <div class="h-64 bg-slate-200 rounded-lg overflow-hidden relative">
            <span class="absolute bottom-2 right-2 bg-green-600 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">AFTER</span>
            <img src="/images/crown-3.jpg" alt="Hair Transplant Result 3" class="w-full h-full object-cover"/>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900 text-center">Crown Area Coverage</p>
        </div>
        <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-100 hover:shadow-md transition">
          <div class="h-64 bg-slate-200 rounded-lg overflow-hidden relative">
            <span class="absolute bottom-2 right-2 bg-green-600 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">AFTER</span>
            <img src="/images/crown-4.jpg" alt="Hair Transplant Result 4" class="w-full h-full object-cover"/>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900 text-center">Natural Temples</p>
        </div>
        <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-100 hover:shadow-md transition">
          <div class="h-64 bg-slate-200 rounded-lg overflow-hidden relative">
            <span class="absolute bottom-2 right-2 bg-green-600 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">AFTER</span>
            <img src="/images/crown-5.jpg" alt="Hair Transplant Result 5" class="w-full h-full object-cover"/>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900 text-center">Dense Packing</p>
        </div>
        <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-100 hover:shadow-md transition">
          <div class="h-64 bg-slate-200 rounded-lg overflow-hidden relative">
            <span class="absolute bottom-2 right-2 bg-green-600 text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">AFTER</span>
            <img src="/images/crown-6.jpg" alt="Hair Transplant Result 6" class="w-full h-full object-cover"/>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900 text-center">Full Restoration</p>
        </div>
      </div>
    </div>

  </Container>
</Layout>