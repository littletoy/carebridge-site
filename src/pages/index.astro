---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";

const wa = "https://wa.me/919840653616?text=Hi%20CareBridge%2C%20I%20need%20a%20free%20medical%20estimate%20for%20treatment%20in%20India";
const waDoctor = "https://wa.me/919840653616?text=Hi%20CareBridge%2C%20I%20want%20to%20speak%20with%20a%20doctor%20about%20my%20condition";
---

<Layout title="CareBridge Health • Save 60-80% on World-Class Treatment in India">
  <Container>
    <div class="relative isolate overflow-hidden bg-white">

      <!-- ============ HERO — Conversion-first ============ -->
      <section class="relative min-h-[100svh] flex items-center bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 text-white overflow-hidden">
        <!-- Ambient glow -->
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-emerald-500/10 rounded-full blur-[180px]"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[160px]"></div>

        <div class="max-w-7xl mx-auto px-5 py-20 md:py-0 w-full">
          <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

            <!-- LEFT: Message -->
            <div>
              <!-- Trust badge -->
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-xl rounded-full border border-white/10 mb-6">
                <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
                <span class="text-emerald-400 font-semibold text-xs tracking-wide">OFFICIAL MANIPAL HOSPITALS PARTNER</span>
              </div>

              <h1 class="text-[2.5rem] sm:text-5xl md:text-6xl lg:text-[4.2rem] font-black leading-[1.08] tracking-tight">
                World-Class Surgery.<br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-blue-400">Save 60-80%</span> vs Your Country.
              </h1>

              <p class="mt-5 text-lg md:text-xl text-slate-300 max-w-lg leading-relaxed">
                Heart surgery from <strong class="text-white">$5,000</strong>. Knee replacement from <strong class="text-white">$4,000</strong>. Cancer treatment from <strong class="text-white">$3,000</strong>. Visa, travel, 5-star stay — all handled.
              </p>

              <!-- MAIN CTA -->
              <div class="mt-8 flex flex-col sm:flex-row gap-3">
                <a href={wa}
                   class="group flex-1 bg-[#25D366] hover:bg-[#1fb855] text-white font-bold text-lg py-5 px-8 rounded-2xl flex items-center justify-center gap-3 shadow-lg shadow-emerald-500/20 transition-all hover:scale-[1.02] active:scale-[0.98]">
                  <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.243-1.214l-.252-.149-2.868.752.765-2.797-.192-.283A7.963 7.963 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"/></svg>
                  Get Free Estimate on WhatsApp
                </a>
                <a href="tel:+919840653616"
                   class="flex-1 sm:flex-none border border-white/20 hover:bg-white/10 text-white font-semibold text-lg py-5 px-8 rounded-2xl flex items-center justify-center gap-3 transition-all">
                  📞 Call Now
                </a>
              </div>

              <!-- Urgency + micro social proof -->
              <div class="mt-5 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-6 text-sm text-slate-400">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-orange-400 rounded-full animate-pulse"></span>
                  <span><strong class="text-orange-300">3 patients</strong> booked today</span>
                </div>
                <div class="flex items-center gap-2">
                  <span>⚡</span>
                  <span>Response in <strong class="text-white">under 30 minutes</strong></span>
                </div>
              </div>

              <!-- Country flags - shows international trust -->
              <div class="mt-8 pt-6 border-t border-white/10">
                <div class="text-xs text-slate-500 mb-3">TRUSTED BY PATIENTS FROM</div>
                <div class="flex flex-wrap gap-2">
                  {["🇮🇶 Iraq", "🇴🇲 Oman", "🇰🇪 Kenya", "🇳🇬 Nigeria", "🇱🇰 Sri Lanka", "🇲🇻 Maldives", "🇸🇴 Somalia", "🇹🇿 Tanzania", "🇺🇿 Uzbekistan", "🇾🇪 Yemen"].map(c => (
                    <span class="px-3 py-1.5 bg-white/5 rounded-full text-xs text-slate-300 border border-white/5">{c}</span>
                  ))}
                </div>
              </div>
            </div>

            <!-- RIGHT: Price comparison card -->
            <div class="relative">
              <div class="bg-white/[0.07] backdrop-blur-xl rounded-3xl border border-white/10 overflow-hidden">
                <div class="bg-gradient-to-r from-emerald-500/20 to-cyan-500/20 px-6 py-4 border-b border-white/10">
                  <div class="text-emerald-400 font-bold text-sm tracking-wide">💰 SEE HOW MUCH YOU SAVE</div>
                </div>
                <div class="p-6 space-y-4">
                  {[
                    { proc: "Heart Bypass Surgery", abroad: "$100,000", india: "$5,000", save: "95%" },
                    { proc: "Knee Replacement", abroad: "$35,000", india: "$4,000", save: "89%" },
                    { proc: "Liver Transplant", abroad: "$300,000", india: "$15,000", save: "95%" },
                    { proc: "Cancer Treatment", abroad: "$50,000", india: "$3,000", save: "94%" },
                    { proc: "IVF / Fertility", abroad: "$15,000", india: "$2,500", save: "83%" },
                    { proc: "Spine Surgery", abroad: "$40,000", india: "$5,500", save: "86%" },
                  ].map(item => (
                    <div class="flex items-center justify-between py-3 border-b border-white/5 last:border-0">
                      <div>
                        <div class="font-semibold text-sm text-white">{item.proc}</div>
                        <div class="text-xs text-slate-500 line-through">{item.abroad} abroad</div>
                      </div>
                      <div class="text-right">
                        <div class="font-bold text-emerald-400 text-lg">{item.india}</div>
                        <div class="text-[10px] font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full">SAVE {item.save}</div>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="p-4 bg-white/5">
                  <a href={wa} class="block w-full bg-[#25D366] hover:bg-[#1fb855] text-white font-bold text-center py-4 rounded-xl transition-all">
                    Get My Personalized Quote →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ TRUST BAR ============ -->
      <section class="py-6 bg-slate-50 border-y border-slate-100">
        <div class="max-w-7xl mx-auto px-5">
          <div class="flex flex-wrap justify-center items-center gap-6 md:gap-12 text-center">
            <div>
              <div class="text-2xl md:text-3xl font-black text-slate-900">2,400+</div>
              <div class="text-xs text-slate-500">Patients Treated</div>
            </div>
            <div class="h-8 w-px bg-slate-200 hidden md:block"></div>
            <div>
              <div class="text-2xl md:text-3xl font-black text-slate-900">47+</div>
              <div class="text-xs text-slate-500">Countries</div>
            </div>
            <div class="h-8 w-px bg-slate-200 hidden md:block"></div>
            <div>
              <div class="flex items-center gap-1 justify-center">
                <span class="text-lg">⭐⭐⭐⭐⭐</span>
                <span class="font-bold text-slate-900">4.98</span>
              </div>
              <div class="text-xs text-slate-500">1,428 Reviews</div>
            </div>
            <div class="h-8 w-px bg-slate-200 hidden md:block"></div>
            <div>
              <div class="text-2xl md:text-3xl font-black text-emerald-600">30 min</div>
              <div class="text-xs text-slate-500">Avg. Response Time</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS — Simple 3 steps ============ -->
      <section class="py-16 md:py-24 bg-white">
        <div class="max-w-5xl mx-auto px-5">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900">How It Works — 3 Simple Steps</h2>
            <p class="mt-3 text-slate-500 text-lg">From your first message to treated & home — we handle everything.</p>
          </div>

          <div class="grid md:grid-cols-3 gap-6 md:gap-10">
            <div class="relative bg-gradient-to-br from-emerald-50 to-white border border-emerald-100 rounded-2xl p-8 text-center">
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 bg-emerald-500 text-white rounded-full flex items-center justify-center font-bold text-sm">1</div>
              <div class="text-4xl mb-4">💬</div>
              <h3 class="font-bold text-lg">Send Reports on WhatsApp</h3>
              <p class="mt-2 text-sm text-slate-600">Share your medical reports. Our doctors review and respond with a treatment plan and cost estimate within hours.</p>
            </div>
            <div class="relative bg-gradient-to-br from-blue-50 to-white border border-blue-100 rounded-2xl p-8 text-center">
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-sm">2</div>
              <div class="text-4xl mb-4">✈️</div>
              <h3 class="font-bold text-lg">We Handle Visa & Travel</h3>
              <p class="mt-2 text-sm text-slate-600">Medical visa, flight booking, airport pickup, hotel near hospital — everything arranged. You just pack your bag.</p>
            </div>
            <div class="relative bg-gradient-to-br from-violet-50 to-white border border-violet-100 rounded-2xl p-8 text-center">
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 bg-violet-500 text-white rounded-full flex items-center justify-center font-bold text-sm">3</div>
              <div class="text-4xl mb-4">🏥</div>
              <h3 class="font-bold text-lg">Get Treated & Go Home</h3>
              <p class="mt-2 text-sm text-slate-600">VIP treatment at India's top hospitals. Personal coordinator with you. 90-day follow-up care after you return home.</p>
            </div>
          </div>

          <div class="mt-10 text-center">
            <a href={wa} class="inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#1fb855] text-white font-bold text-lg py-5 px-10 rounded-2xl shadow-lg shadow-emerald-500/20 transition-all hover:scale-[1.02]">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.243-1.214l-.252-.149-2.868.752.765-2.797-.192-.283A7.963 7.963 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"/></svg>
              Start My Free Consultation
            </a>
            <p class="mt-3 text-sm text-slate-400">Free. No commitment. Reply in under 30 minutes.</p>
          </div>
        </div>
      </section>

      <!-- ============ MEET YOUR DOCTORS ============ -->
      <section class="py-16 md:py-24 bg-gradient-to-b from-white to-slate-50">
        <div class="max-w-6xl mx-auto px-5">
          <div class="text-center mb-12">
            <div class="text-emerald-600 font-bold text-xs tracking-[2px] mb-3">YOUR CARE TEAM</div>
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Meet the Doctors Who Will Treat You</h2>
            <p class="mt-3 text-slate-500 text-lg">Senior specialists from Manipal Hospitals — India's top medical group</p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
            {[
              {
                img: "/doctor_photos/Dr_Anand_R_Shenoy.jpg",
                name: "Dr. Anand R Shenoy",
                specialty: "Interventional Cardiology",
                credentials: "MBBS, MD, DM, FSCAI (USA), FACC, FRCP",
                experience: "8,000+ interventions",
                surgeries: "4,000+ angioplasties"
              },
              {
                img: "/doctor_photos/Dr_Mallikarjun_Kalashetty.jpg",
                name: "Dr. Mallikarjun Kalashetty",
                specialty: "HOD — Haemato-Oncology & Bone Marrow Transplant",
                credentials: "MBBS, MD, DM, Fellowship (Vancouver, Canada)",
                experience: "Bone Marrow Transplant specialist",
                surgeries: "500+ transplants performed"
              },
              {
                img: "/doctor_photos/Dr_Hemant_K_Kalyan.jpg",
                name: "Dr. Hemant K Kalyan",
                specialty: "Orthopaedic & Robotic Joint Replacement",
                credentials: "MBBS, MS Ortho, Fellowship (University of Toronto)",
                experience: "Joint replacement specialist",
                surgeries: "Knee, Hip & Robotic surgery"
              },
              {
                img: "/doctor_photos/Dr_Sanjeev_Rohatgi.jpg",
                name: "Dr. Sanjeev Rohatgi",
                specialty: "Lead — Liver Transplant & HPB Surgery",
                credentials: "MBBS, MS, Fellowship (Royal Infirmary Edinburgh, UK)",
                experience: "Liver & Pancreas Transplant",
                surgeries: "Adult & Paediatric transplants"
              }
            ].map(doc => (
              <div class="group bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-xl transition-all hover:-translate-y-1">
                <div class="relative aspect-[4/5] overflow-hidden bg-slate-100">
                  <img 
                    src={doc.img} 
                    alt={doc.name}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4">
                    <div class="text-white font-bold text-base">{doc.name}</div>
                    <div class="text-emerald-300 text-xs font-semibold">{doc.specialty}</div>
                  </div>
                </div>
                <div class="p-4">
                  <div class="text-xs text-slate-500">{doc.credentials}</div>
                  <div class="mt-2 flex items-center justify-between text-xs">
                    <span class="text-slate-600">🏥 {doc.experience}</span>
                    <span class="text-emerald-600 font-bold">{doc.surgeries}</span>
                  </div>
                  <a href={`${wa}%20-%20I%20want%20to%20consult%20${doc.name}`}
                     class="mt-3 block w-full text-center bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold text-xs py-2.5 rounded-xl transition-colors">
                    Book Free Consultation →
                  </a>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-8 text-center">
            <a href={wa} class="inline-flex items-center gap-2 text-emerald-600 font-semibold hover:text-emerald-700 transition-colors">
              <span>See all 450+ specialists available for your condition</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ============ HOSPITALS — Two tiers (legally safe) ============ -->
      <section class="py-16 md:py-24 bg-slate-900 text-white">
        <div class="max-w-6xl mx-auto px-5">

          <!-- TIER 1: Manipal - Official Partner -->
          <div class="grid lg:grid-cols-2 gap-10 items-center">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-500/20 rounded-full border border-emerald-500/30 mb-4">
                <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                <span class="text-emerald-400 font-bold text-[10px] tracking-[2px]">OFFICIAL EXCLUSIVE PARTNER</span>
              </div>
              <h2 class="text-3xl md:text-5xl font-bold leading-tight">Manipal Hospitals</h2>
              <p class="mt-4 text-lg text-slate-300">28 hospitals. 9,000+ beds. JCI accredited. India's 3rd largest healthcare group. Our patients get priority appointments within 48 hours.</p>
              
              <div class="mt-8 grid grid-cols-2 gap-4 text-sm">
                <div class="bg-white/5 rounded-xl p-4">✅ Priority slots in 48 hrs</div>
                <div class="bg-white/5 rounded-xl p-4">✅ Dedicated international desk</div>
                <div class="bg-white/5 rounded-xl p-4">✅ Visa invitation letters</div>
                <div class="bg-white/5 rounded-xl p-4">✅ Airport-to-hospital transfers</div>
                <div class="bg-white/5 rounded-xl p-4">✅ English & Arabic support</div>
                <div class="bg-white/5 rounded-xl p-4">✅ 90-day post-treatment care</div>
              </div>
            </div>
            <div class="rounded-3xl overflow-hidden shadow-2xl">
              <img src="/VmJrama5RuC2UkdwRtPMgn7DStLjdCvzR2JKGBzr.avif" alt="Manipal Hospitals" class="w-full aspect-[4/3] object-cover" />
            </div>
          </div>

          <!-- DIVIDER -->
          <div class="my-12 md:my-16 border-t border-white/10"></div>

          <!-- TIER 2: Other hospitals - "We also facilitate" (no partnership claim) -->
          <div class="text-center">
            <div class="text-cyan-400 font-bold text-xs tracking-[2px] mb-4">WE ALSO FACILITATE TREATMENT AT</div>
            <h3 class="text-2xl md:text-3xl font-bold">India's Largest Hospital Networks</h3>
            <p class="mt-3 text-slate-400 max-w-2xl mx-auto">
              Beyond our exclusive Manipal partnership, we coordinate appointments, second opinions, and treatment plans with India's other top JCI/NABH accredited hospitals.
            </p>

            <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
              {[
                { name: "Apollo Hospitals", beds: "10,000+ beds", cities: "73 hospitals" },
                { name: "Fortis Healthcare", beds: "4,000+ beds", cities: "28 hospitals" },
                { name: "Max Healthcare", beds: "3,400+ beds", cities: "17 hospitals" },
                { name: "Narayana Health", beds: "6,200+ beds", cities: "23 hospitals" },
                { name: "Aster DM", beds: "4,000+ beds", cities: "19 hospitals" },
                { name: "Medanta", beds: "2,600+ beds", cities: "5 hospitals" },
              ].map(h => (
                <div class="bg-white/5 hover:bg-white/10 border border-white/5 rounded-xl p-4 transition-all text-center">
                  <div class="font-bold text-sm text-white">{h.name}</div>
                  <div class="text-[10px] text-slate-400 mt-1">{h.beds}</div>
                  <div class="text-[10px] text-slate-500">{h.cities}</div>
                </div>
              ))}
            </div>

            <p class="mt-6 text-xs text-slate-500 max-w-xl mx-auto">
              We help you find the best doctor and hospital for your specific condition across India's entire JCI/NABH network of 800+ accredited hospitals.
            </p>
          </div>
        </div>
      </section>

      <!-- ============ SPECIALTIES — Compact ============ -->
      <section class="py-16 md:py-24 bg-white">
        <div class="max-w-6xl mx-auto px-5">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold">Treatments We Specialize In</h2>
            <p class="mt-3 text-slate-500">Tap any specialty to get a free WhatsApp estimate</p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
            {[
              { icon: "❤️", name: "Heart Surgery", price: "From $5,000" },
              { icon: "🦴", name: "Knee/Hip Replacement", price: "From $4,000" },
              { icon: "🎗️", name: "Cancer Treatment", price: "From $3,000" },
              { icon: "🫀", name: "Organ Transplant", price: "From $15,000" },
              { icon: "🧠", name: "Brain & Spine", price: "From $5,500" },
              { icon: "👶", name: "IVF & Fertility", price: "From $2,500" },
              { icon: "👁️", name: "Eye Surgery", price: "From $1,500" },
              { icon: "✨", name: "Cosmetic Surgery", price: "From $2,000" },
            ].map(s => (
              <a href={`${wa}%20-%20I%20need%20${s.name}%20estimate`}
                 class="group border border-slate-100 hover:border-emerald-200 hover:shadow-lg rounded-2xl p-5 md:p-6 transition-all hover:-translate-y-1 block">
                <div class="text-3xl mb-3">{s.icon}</div>
                <div class="font-bold text-sm md:text-base text-slate-900">{s.name}</div>
                <div class="text-emerald-600 font-bold text-sm mt-1">{s.price}</div>
                <div class="text-[10px] text-slate-400 mt-2 group-hover:text-emerald-500 transition-colors">Tap for free quote →</div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ TESTIMONIALS ============ -->
      <section class="py-16 md:py-24 bg-slate-50">
        <div class="max-w-6xl mx-auto px-5">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold">Real Patients. Real Results.</h2>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
              <div class="flex items-center gap-1 text-amber-400 mb-3">⭐⭐⭐⭐⭐</div>
              <p class="text-slate-700 text-sm leading-relaxed">"My father needed heart bypass surgery. In Iraq it was too risky. CareBridge arranged everything — visa, flight, hospital in Chennai. Surgery was successful. Total cost was 1/10th of what we were quoted in Jordan."</p>
              <div class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center text-lg">🇮🇶</div>
