---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";

const whatsappLink = "https://wa.me/919840653616?text=Hi%20CareBridge%2C%20I'm%20an%20international%20patient%20looking%20for%20premium%20treatment%20in%20India%20%E2%80%93%20please%20connect%20me%20with%20your%20team";
---

<Layout title="CareBridge Health • Premium Medical Tourism in India | Official Manipal Partner">
  <Container>
    <!-- LUXURY GLOW WRAPPER + CEO VISION -->
    <div class="relative isolate overflow-hidden bg-slate-50">
      <!-- Enhanced Master Glows -->
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-x-0 top-0 h-[900px] bg-gradient-to-br from-blue-500/15 via-cyan-400/25 to-violet-500/15 blur-3xl"></div>
        <div class="absolute -left-60 top-32 h-[520px] w-[520px] rounded-full bg-gradient-to-br from-cyan-400/40 to-blue-600/30 blur-[140px]"></div>
        <div class="absolute -right-60 top-[420px] h-[520px] w-[520px] rounded-full bg-gradient-to-br from-violet-400/40 to-indigo-600/30 blur-[140px]"></div>
        <div class="absolute bottom-20 left-1/2 h-96 w-96 rounded-full bg-gradient-to-br from-emerald-400/30 to-teal-500/30 blur-[110px]"></div>
      </div>

      <!-- HERO – CEO Level Vision -->
      <section class="min-h-screen pt-24 lg:pt-32 pb-20 flex items-center relative">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-16 items-center px-6">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-3 px-8 py-3 bg-white/95 backdrop-blur-2xl rounded-3xl border border-white shadow-2xl mb-8">
              <span class="text-emerald-500 text-xl">🏆</span>
              <span class="font-bold text-emerald-700 tracking-[1.5px] uppercase text-sm">Official International Partner of Manipal Hospitals</span>
            </div>

            <h1 class="text-6xl lg:text-7xl xl:text-[82px] font-black leading-[1.05] tracking-tighter text-slate-950">
              India's Finest Care.<br>
              <span class="bg-gradient-to-r from-blue-700 via-cyan-600 to-violet-600 bg-clip-text text-transparent">Delivered with White-Glove Excellence.</span>
            </h1>

            <p class="mt-8 max-w-2xl text-2xl text-slate-600 font-light">
              We are a fast-growing startup connecting discerning international patients to world-class hospitals in India — with AI-powered coordination, visa & travel concierge, and 24/7 human support.
            </p>

            <div class="mt-12 flex flex-col sm:flex-row gap-5">
              <a href={whatsappLink}
                 class="group flex-1 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold text-2xl py-8 px-14 rounded-3xl flex items-center justify-center gap-5 shadow-2xl transition-all hover:scale-[1.03]">
                <span>Start Your Journey on WhatsApp</span>
                <span class="text-4xl transition group-hover:rotate-12">💬</span>
              </a>
              <a href="#partners" class="flex-1 border-2 border-slate-900 hover:bg-slate-900 hover:text-white font-semibold text-xl py-8 px-14 rounded-3xl text-center transition-all">
                See Our Partners →
              </a>
            </div>

            <!-- Trust + Startup Growth Signal -->
            <div class="mt-16 flex items-center gap-12 text-sm">
              <div>
                <div class="font-black text-4xl text-emerald-600">47+</div>
                <div class="text-slate-500">Countries Served</div>
              </div>
              <div class="h-12 w-px bg-slate-200"></div>
              <div>
                <div class="flex items-center gap-3">
                  <span class="text-3xl">⭐⭐⭐⭐⭐</span>
                  <div>
                    <div class="font-bold">4.98/5</div>
                    <div class="text-xs text-slate-500">1,428 verified reviews</div>
                  </div>
                </div>
              </div>
              <div class="h-12 w-px bg-slate-200"></div>
              <div class="text-xs leading-tight">
                <span class="block font-bold text-slate-900">Actively partnering with more JCI/NABH hospitals</span>
                <span class="text-emerald-600">→ Become our next strategic partner</span>
              </div>
            </div>
          </div>

          <!-- Hero Visual -->
          <div class="lg:col-span-5 relative">
            <div class="rounded-[3.5rem] overflow-hidden shadow-2xl ring-1 ring-white/60">
              <img 
                src="/VmJrama5RuC2UkdwRtPMgn7DStLjdCvzR2JKGBzr.avif"
                alt="Manipal Hospitals – Premium Care"
                class="w-full aspect-[16/10] object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            </div>

            <!-- Floating VIP Card -->
            <div class="absolute -bottom-6 -left-6 bg-white rounded-3xl shadow-2xl p-6 max-w-[260px]">
              <div class="flex gap-4">
                <div class="text-6xl">🏥</div>
                <div>
                  <div class="text-emerald-600 font-bold text-sm tracking-widest">NEXT AVAILABLE</div>
                  <div class="font-black text-3xl text-slate-900">48 hrs</div>
                  <div class="text-slate-500 text-sm">for specialist consultation</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- WHY CAREBRIDGE – Premium Concierge -->
      <section class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-16">
            <div class="text-cyan-600 text-sm font-black tracking-[3px]">FOR DISCERNING GLOBAL PATIENTS</div>
            <h2 class="text-5xl font-bold mt-4">Luxury. Speed. Certainty.</h2>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="group bg-gradient-to-br from-white to-cyan-50 border border-cyan-100 rounded-3xl p-10 hover:-translate-y-3 transition-all">
              <div class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl flex items-center justify-center text-5xl mb-8">📋</div>
              <h3 class="text-2xl font-bold">Instant Expert Review</h3>
              <p class="mt-4 text-slate-600">Share reports on WhatsApp. AI + senior doctors respond in hours.</p>
            </div>
            <div class="group bg-gradient-to-br from-white to-violet-50 border border-violet-100 rounded-3xl p-10 hover:-translate-y-3 transition-all">
              <div class="w-16 h-16 bg-gradient-to-br from-violet-500 to-purple-600 rounded-2xl flex items-center justify-center text-5xl mb-8">🏆</div>
              <h3 class="text-2xl font-bold">Elite Hospital Network</h3>
              <p class="mt-4 text-slate-600">Manipal + growing list of India’s top JCI-accredited centres.</p>
            </div>
            <div class="group bg-gradient-to-br from-white to-emerald-50 border border-emerald-100 rounded-3xl p-10 hover:-translate-y-3 transition-all">
              <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl flex items-center justify-center text-5xl mb-8">✈️</div>
              <h3 class="text-2xl font-bold">White-Glove Travel</h3>
              <p class="mt-4 text-slate-600">Visa, flights, 5-star stay, private transfers — everything handled.</p>
            </div>
            <div class="group bg-gradient-to-br from-white to-rose-50 border border-rose-100 rounded-3xl p-10 hover:-translate-y-3 transition-all">
              <div class="w-16 h-16 bg-gradient-to-br from-rose-500 to-pink-600 rounded-2xl flex items-center justify-center text-5xl mb-8">🤖</div>
              <h3 class="text-2xl font-bold">Sarah AI + Human Team</h3>
              <p class="mt-4 text-slate-600">24/7 AI coordinator backed by real care managers who never sleep.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- OFFICIAL PARTNERSHIP + GROWTH -->
      <section id="partners" class="py-24 bg-slate-900 text-white">
        <div class="max-w-6xl mx-auto px-6">
          <div class="bg-gradient-to-br from-zinc-900 to-slate-900 rounded-[3rem] overflow-hidden relative">
            <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-3xl"></div>

            <div class="grid lg:grid-cols-2">
              <div class="p-16 lg:p-20">
                <div class="uppercase text-emerald-400 font-bold tracking-[3px]">EXCLUSIVE PARTNER</div>
                <h2 class="text-5xl font-bold mt-6 leading-none">Manipal Hospitals</h2>
                <p class="mt-8 text-xl text-slate-300">Priority access, dedicated international wing, faster appointments, and seamless coordination for our patients.</p>
                
                <div class="mt-12 grid grid-cols-2 gap-8 text-sm">
                  <div class="space-y-4">
                    <div>✓ Priority slots in 48 hrs</div>
                    <div>✓ Dedicated international desk</div>
                    <div>✓ English-speaking care managers</div>
                  </div>
                  <div class="space-y-4">
                    <div>✓ Visa invitation letters</div>
                    <div>✓ Airport-to-hospital transfers</div>
                    <div>✓ 90-day post-treatment support</div>
                  </div>
                </div>

                <div class="mt-16 text-xs text-emerald-400 font-bold tracking-widest">AND GROWING...</div>
                <p class="text-slate-400 text-sm">We are actively onboarding more top-tier hospitals across India. If you run a JCI/NABH hospital, let’s talk.</p>
              </div>

              <div class="relative min-h-[520px]">
                <img src="/VmJrama5RuC2UkdwRtPMgn7DStLjdCvzR2JKGBzr.avif" class="absolute inset-0 w-full h-full object-cover" alt="Manipal">
                <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 to-transparent"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CENTERS OF EXCELLENCE – Expanded + Oncology Flagship -->
      <section class="py-28 bg-white">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex flex-col md:flex-row justify-between items-end mb-16">
            <div>
              <span class="text-xs font-black tracking-[4px] text-violet-600">WORLD-CLASS SPECIALTIES</span>
              <h2 class="text-5xl font-bold mt-3">Centers of Excellence</h2>
            </div>
            <a href={whatsappLink} class="text-sm font-medium flex items-center gap-2 hover:gap-3 transition-all mt-6 md:mt-0">
              Tell us your condition → <span class="text-xl">💬</span>
            </a>
          </div>

          <!-- Flagship Oncology -->
          <div class="mb-12 bg-gradient-to-br from-rose-50 to-white border border-rose-200 rounded-3xl p-12 flex flex-col lg:flex-row gap-12 items-center group">
            <div class="lg:w-2/5">
              <div class="inline px-5 py-1.5 bg-rose-100 text-rose-700 rounded-full text-xs font-bold">FLAGHSHIP SPECIALTY</div>
              <h3 class="text-4xl font-bold mt-6">Oncology & Cancer Care</h3>
              <p class="mt-4 text-slate-600 text-lg">Robotic surgery, immunotherapy, precision oncology — delivered by India’s top cancer institutes at a fraction of global cost.</p>
              <a href={whatsappLink} class="mt-8 inline-flex bg-rose-600 text-white font-semibold px-10 py-5 rounded-2xl hover:bg-rose-700">Get Oncology Quote</a>
            </div>
            <div class="flex-1 grid grid-cols-2 gap-6 text-sm">
              <div class="bg-white rounded-2xl p-6 shadow">✓ Proton Therapy</div>
              <div class="bg-white rounded-2xl p-6 shadow">✓ Bone Marrow Transplant</div>
              <div class="bg-white rounded-2xl p-6 shadow">✓ Targeted Therapy</div>
              <div class="bg-white rounded-2xl p-6 shadow">✓ 2nd Opinion in 24 hrs</div>
            </div>
          </div>

          <!-- Rest of Specialties -->
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <div class="bg-white border hover:border-cyan-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-blue-500 to-cyan-400 rounded-2xl flex items-center justify-center text-5xl mb-6">❤️</div>
              <div class="font-bold text-xl">Cardiology & CTVS</div>
            </div>
            <div class="bg-white border hover:border-amber-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-amber-500 to-yellow-400 rounded-2xl flex items-center justify-center text-5xl mb-6">🦴</div>
              <div class="font-bold text-xl">Orthopedics & Joints</div>
            </div>
            <div class="bg-white border hover:border-purple-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-purple-500 to-violet-400 rounded-2xl flex items-center justify-center text-5xl mb-6">👶</div>
              <div class="font-bold text-xl">IVF & Fertility</div>
            </div>
            <div class="bg-white border hover:border-teal-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-teal-500 to-cyan-400 rounded-2xl flex items-center justify-center text-5xl mb-6">🧠</div>
              <div class="font-bold text-xl">Neurology & Spine</div>
            </div>
            <div class="bg-white border hover:border-emerald-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-emerald-500 to-teal-400 rounded-2xl flex items-center justify-center text-5xl mb-6">🫀</div>
              <div class="font-bold text-xl">Organ Transplant</div>
            </div>
            <div class="bg-white border hover:border-pink-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-pink-500 to-rose-400 rounded-2xl flex items-center justify-center text-5xl mb-6">✨</div>
              <div class="font-bold text-xl">Cosmetic Surgery</div>
            </div>
            <div class="bg-white border hover:border-sky-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-sky-500 to-blue-400 rounded-2xl flex items-center justify-center text-5xl mb-6">👁️</div>
              <div class="font-bold text-xl">Ophthalmology</div>
            </div>
            <div class="bg-white border hover:border-orange-300 group rounded-3xl p-8 text-center transition-all hover:-translate-y-1">
              <div class="mx-auto w-20 h-20 bg-gradient-to-br from-orange-500 to-amber-400 rounded-2xl flex items-center justify-center text-5xl mb-6">🦷</div>
              <div class="font-bold text-xl">Dental & Hair</div>
            </div>
          </div>
        </div>
      </section>

      <!-- JOURNEY -->
      <section id="journey" class="py-28 bg-gradient-to-b from-slate-50 to-white">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-5xl font-bold">Your 5-Star Healing Journey</h2>
          </div>
          <div class="grid md:grid-cols-5 gap-6">
            <div class="bg-white rounded-3xl p-10 shadow-xl">
              <div class="font-mono text-7xl text-cyan-200 font-black">01</div>
              <div class="mt-8 font-bold text-2xl">Send Reports</div>
              <p class="mt-4 text-slate-600">WhatsApp your medical files. Sarah organises instantly.</p>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl">
              <div class="font-mono text-7xl text-cyan-200 font-black">02</div>
              <div class="mt-8 font-bold text-2xl">Expert Matching</div>
              <p class="mt-4 text-slate-600">Top doctors review and quote within 24 hrs.</p>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl">
              <div class="font-mono text-7xl text-cyan-200 font-black">03</div>
              <div class="mt-8 font-bold text-2xl">Visa & Travel</div>
              <p class="mt-4 text-slate-600">Invitation letter, flights, luxury stay arranged.</p>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl">
              <div class="font-mono text-7xl text-cyan-200 font-black">04</div>
              <div class="mt-8 font-bold text-2xl">Treatment</div>
              <p class="mt-4 text-slate-600">VIP experience with personal coordinator.</p>
            </div>
            <div class="bg-white rounded-3xl p-10 shadow-xl">
              <div class="font-mono text-7xl text-cyan-200 font-black">05</div>
              <div class="mt-8 font-bold text-2xl">Safe Return Home</div>
              <p class="mt-4 text-slate-600">Follow-up care for 90 days included.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- SARAH AI – Fixed WhatsApp -->
      <section class="py-28 relative">
        <div class="max-w-5xl mx-auto bg-gradient-to-br from-zinc-950 via-slate-900 to-black rounded-[3rem] p-16 text-white overflow-hidden">
          <div class="absolute inset-0 bg-[radial-gradient(#3b82f620_1px,transparent_1px)] [background-size:30px_30px]"></div>

          <div class="grid md:grid-cols-2 gap-16 items-center relative z-10">
            <div>
              <div class="flex items-center gap-5">
                <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center text-6xl shadow-inner">🤖</div>
                <div>
                  <div class="uppercase text-emerald-400 font-bold">24/7 AI + HUMAN</div>
                  <h2 class="text-5xl font-bold leading-none mt-3">Meet Sarah,<br>Your Personal Medical Angel</h2>
                </div>
              </div>
              <p class="mt-8 text-xl text-slate-300">She speaks your language, reads your reports, books appointments, and keeps you updated — always with a human care manager ready.</p>

              <!-- FIXED WHATSAPP BUTTON -->
              <a href={whatsappLink}
                 class="mt-12 inline-flex items-center gap-4 bg-white hover:bg-emerald-400 hover:text-white text-slate-950 font-bold text-xl px-12 py-7 rounded-3xl transition-all shadow-xl">
                Message Sarah on WhatsApp Now <span class="text-3xl">→</span>
              </a>
            </div>

            <div class="bg-white/10 backdrop-blur-2xl border border-white/10 rounded-3xl p-8 text-sm space-y-6">
              <div class="bg-white/10 p-5 rounded-2xl">Hi Sarah, I need advanced knee replacement. Here are my reports.</div>
              <div class="bg-gradient-to-r from-cyan-400/30 to-blue-500/30 p-5 rounded-2xl ml-auto max-w-[85%]">Thank you! Dr. Shetty at Manipal can see you next week with VIP package. Shall I proceed?</div>
            </div>
          </div>
        </div>
      </section>

      <!-- TRAVEL CONCIERGE -->
      <section class="py-28 bg-gradient-to-br from-cyan-50 via-white to-emerald-50">
        <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-5xl font-bold">From Your Home Country<br>to Healing in India</h2>
            <ul class="mt-12 space-y-10 text-lg">
              <li class="flex gap-8"><span class="text-6xl">🛂</span> <div><strong>Medical Visa in 72 hrs</strong><p class="text-slate-600">Full documentation support</p></div></li>
              <li class="flex gap-8"><span class="text-6xl">🏨</span> <div><strong>5-Star Recovery Stays</strong><p class="text-slate-600">Near hospital, fully supported</p></div></li>
              <li class="flex gap-8"><span class="text-6xl">🚘</span> <div><strong>Private Transfers & Escort</strong><p class="text-slate-600">Mercedes with medical staff</p></div></li>
            </ul>
          </div>
          <div class="rounded-3xl overflow-hidden shadow-2xl relative">
            <img src="https://picsum.photos/id/1015/1200/800" alt="Luxury India Travel" class="w-full">
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 p-12 text-white">
              <div class="font-bold text-3xl">One message.<br>Everything arranged.</div>
            </div>
          </div>
        </div>
      </section>

      <!-- FOR HOSPITALS – STARTUP GROWTH SECTION -->
      <section class="py-24 bg-slate-900 text-white">
        <div class="max-w-5xl mx-auto px-6 text-center">
          <div class="text-emerald-400 font-bold tracking-widest text-sm">FOR HOSPITALS & HEALTHCARE GROUPS</div>
          <h2 class="text-5xl font-bold mt-6">Let’s Grow International Patient Flow Together</h2>
          <p class="max-w-2xl mx-auto mt-6 text-xl text-slate-300">As a startup, we are selectively onboarding more premium hospitals. Get direct access to high-intent international patients, dedicated coordination, and marketing support.</p>
          
          <a href={whatsappLink} class="mt-12 inline-block bg-white text-slate-900 font-bold text-2xl px-16 py-8 rounded-3xl hover:bg-emerald-400 hover:text-white transition">
            Partner With CareBridge →
          </a>
          <div class="mt-8 text-xs text-slate-500">Currently onboarding 3-5 new partners in 2026</div>
        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="py-32 bg-gradient-to-br from-blue-700 via-violet-700 to-indigo-700 text-white">
        <div class="max-w-4xl mx-auto text-center px-6">
          <h2 class="text-6xl font-black leading-none">Ready to begin the best chapter<br>of your health story?</h2>
          <p class="mt-8 text-2xl opacity-90">Thousands have already healed with us. Your turn is now.</p>
          
          <a href={whatsappLink}
             class="mt-14 inline-block bg-white text-slate-950 font-black text-3xl px-20 py-9 rounded-3xl hover:bg-emerald-400 hover:text-white transition-all shadow-2xl">
            Start VIP Consultation on WhatsApp
          </a>
        </div>
      </section>
    </div>
  </Container>
</Layout>