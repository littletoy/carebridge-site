---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thank You – CareBridge Health">
  <main class="container mx-auto px-5 py-16 max-w-2xl text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
      Thank you for your enquiry
    </h1>

    <p class="text-lg text-slate-600 mb-6">
      We’ve received your details. A CareBridge Health coordinator will review
      your case and contact you soon via email or WhatsApp.
    </p>

    <p class="text-sm text-slate-500 mb-10">
      If your case is urgent, you can message us directly on WhatsApp using the
      button below.
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/"
        class="px-6 py-3 rounded-lg border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition"
      >
        Back to Home
      </a>

      <a
        href="https://wa.me/919080553616"
        target="_blank"
        rel="noopener"
        class="px-6 py-3 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition"
      >
        Chat on WhatsApp
      </a>
    </div>
  </main>
</Layout>
