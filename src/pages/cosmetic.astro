---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
---

<Layout title="Cosmetic Surgery in India | CareBridge Health">
  <Container>
    <div class="mt-16 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
        World-Class Plastic Surgery<br>
        <span class="text-blue-600">at 60% Less Cost</span>
      </h1>
      <p class="text-lg mt-4 text-slate-600">
        Achieve your dream look with India's top Board-Certified Plastic Surgeons. 
        Privacy focused, luxury recovery suites, and hidden scar techniques.
      </p>
      
      <div class="mt-8 flex justify-center gap-4">
        <a href="/book" class="bg-black text-white px-6 py-3 rounded-lg font-medium hover:bg-slate-800 transition">
          Book Video Consult
        </a>
        <a href="https://wa.me/919994581853" class="bg-green-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-700 transition flex items-center gap-2">
          <span>WhatsApp Quote</span>
        </a>
      </div>
    </div>

    <div class="mt-24">
      <h2 class="text-3xl font-bold text-center mb-10">Transparent Pricing</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100 text-slate-900">
              <th class="p-4 border-b-2 border-slate-200">Procedure</th>
              <th class="p-4 border-b-2 border-slate-200">USA / UK Cost</th>
              <th class="p-4 border-b-2 border-slate-200">Thailand Cost</th>
              <th class="p-4 border-b-2 border-blue-600 bg-blue-50 text-blue-800">CareBridge India</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-4 border-b">Rhinoplasty (Nose Job)</td>
              <td class="p-4 border-b text-red-600 font-medium">$8,500</td>
              <td class="p-4 border-b">$3,500</td>
              <td class="p-4 border-b font-bold text-green-700">$2,200</td>
            </tr>
            <tr>
              <td class="p-4 border-b">Liposuction (360 Lipo)</td>
              <td class="p-4 border-b text-red-600 font-medium">$9,000</td>
              <td class="p-4 border-b">$4,000</td>
              <td class="p-4 border-b font-bold text-green-700">$2,500</td>
            </tr>
            <tr>
              <td class="p-4 border-b">Breast Augmentation</td>
              <td class="p-4 border-b">$7,500</td>
              <td class="p-4 border-b">$3,800</td>
              <td class="p-4 border-b font-bold">$2,300</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-24 grid md:grid-cols-2 gap-10 items-center">
      <div>
         <img 
          src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?q=80&w=2080&auto=format&fit=crop" 
          alt="Plastic Surgery Consultation" 
          class="rounded-lg shadow-xl"
        />
      </div>
      <div>
        <h2 class="text-3xl font-bold text-slate-900 mb-6">Privacy & Luxury Recovery</h2>
        <ul class="space-y-4">
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">1</span>
            <div>
              <strong class="block text-slate-900">100% Confidential</strong>
              <p class="text-slate-600">We sign strict NDAs. Your photos are never shared without explicit written permission.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">2</span>
            <div>
              <strong class="block text-slate-900">Luxury Recovery Suites</strong>
              <p class="text-slate-600">Recover in a 5-star private room with 24/7 nursing care, not a crowded hospital ward.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">3</span>
            <div>
              <strong class="block text-slate-900">Board Certified Surgeons</strong>
              <p class="text-slate-600">All our partner surgeons have 15+ years of experience and international fellowships.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
    
  </Container>
</Layout>