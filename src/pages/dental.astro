---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
---

<Layout title="Dental Implants in India | CareBridge Health">
  <Container>
    <div class="mt-16 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
        Swiss-Quality Dental Implants<br>
        <span class="text-blue-600">at 80% Less Cost</span>
      </h1>
      <p class="text-lg mt-4 text-slate-600">
        We strictly use Nobel Biocare™ and Straumann™ implants. 
        Get a full mouth restoration for the price of a single tooth in the US.
      </p>
      
      <div class="mt-8 flex justify-center gap-4">
        <a href="/book" class="bg-black text-white px-6 py-3 rounded-lg font-medium hover:bg-slate-800 transition">
          Book Video Consult
        </a>
        <a href="https://wa.me/919994581853" class="bg-green-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-700 transition flex items-center gap-2">
          <span>WhatsApp Quote</span>
        </a>
      </div>
    </div>

    <div class="mt-24">
      <h2 class="text-3xl font-bold text-center mb-10">Compare the Brands & Prices</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100 text-slate-900">
              <th class="p-4 border-b-2 border-slate-200">Treatment</th>
              <th class="p-4 border-b-2 border-slate-200">USA / UK Cost</th>
              <th class="p-4 border-b-2 border-slate-200">Turkey Cost</th>
              <th class="p-4 border-b-2 border-blue-600 bg-blue-50 text-blue-800">CareBridge India</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-4 border-b">Single Titanium Implant</td>
              <td class="p-4 border-b text-red-600 font-medium">$4,000</td>
              <td class="p-4 border-b">$800</td>
              <td class="p-4 border-b font-bold text-green-700">$450</td>
            </tr>
            <tr>
              <td class="p-4 border-b">All-on-4 (Full Jaw)</td>
              <td class="p-4 border-b text-red-600 font-medium">$25,000</td>
              <td class="p-4 border-b">$6,000</td>
              <td class="p-4 border-b font-bold text-green-700">$3,500</td>
            </tr>
            <tr>
              <td class="p-4 border-b">Zirconia Crown</td>
              <td class="p-4 border-b">$1,500</td>
              <td class="p-4 border-b">$300</td>
              <td class="p-4 border-b font-bold">$180</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-24 grid md:grid-cols-2 gap-10 items-center">
      <div class="order-2 md:order-1">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">World-Class Safety Standards</h2>
        <ul class="space-y-4">
          <li class="flex gap-3">
            <span class="w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center font-bold text-sm">✓</span>
            <p class="text-slate-600"><strong>Class-B Autoclave:</strong> We use vacuum sterilization (same standard as UK hospitals).</p>
          </li>
          <li class="flex gap-3">
            <span class="w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center font-bold text-sm">✓</span>
            <p class="text-slate-600"><strong>Genuine Parts:</strong> We provide the barcode sticker for every Nobel/Straumann implant used.</p>
          </li>
          <li class="flex gap-3">
            <span class="w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center font-bold text-sm">✓</span>
            <p class="text-slate-600"><strong>15-Year Warranty:</strong> If an implant fails (very rare), we replace it for free.</p>
          </li>
        </ul>
      </div>
      <div class="order-1 md:order-2">
         <img 
          src="https://images.unsplash.com/photo-1609840114035-3c981b782dfe?q=80&w=2070&auto=format&fit=crop" 
          alt="Modern Dental Clinic India" 
          class="rounded-lg shadow-xl"
        />
      </div>
    </div>
    
  </Container>
</Layout>