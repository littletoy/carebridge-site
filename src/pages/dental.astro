---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dental Treatments in India – CareBridge Health">
  <main class="container mx-auto px-5 py-12 max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-bold mb-6">
      Dental Implants & Smile Makeovers in India
    </h1>

    <p class="text-slate-600 text-lg mb-8">
      We coordinate advanced dental treatments with carefully selected clinics
      in India – combining international-standard care with affordable pricing.
    </p>

    <section class="mb-10 space-y-4">
      <h2 class="text-2xl font-semibold">Key Dental Services</h2>
      <ul class="list-disc list-inside space-y-2 text-slate-600">
        <li>Single and multiple dental implants</li>
        <li>Full-mouth rehabilitation / All-on-4 & All-on-6</li>
        <li>Crowns, bridges and smile design (veneers)</li>
        <li>Root canals, fillings and general dentistry</li>
        <li>Teeth whitening and cosmetic corrections</li>
      </ul>
    </section>

    <section class="mb-10 space-y-4">
      <h2 class="text-2xl font-semibold">Why Dental Tourism in India?</h2>
      <ul class="list-disc list-inside space-y-2 text-slate-600">
        <li>Save up to 60–70% vs. US/UK/Europe pricing</li>
        <li>Treatment plans prepared before you travel</li>
        <li>Work with English-speaking specialists</li>
        <li>Short treatment windows planned around your stay</li>
      </ul>
    </section>

    <section class="bg-slate-50 rounded-xl p-6 mt-4">
      <h2 class="text-xl font-semibold mb-3">Share Your Dental X-rays</h2>
      <p class="text-slate-600 mb-4">
        Email or WhatsApp your recent X-rays / reports and we’ll arrange a
        treatment estimate from a partner dental centre.
      </p>
      <a
        href="https://wa.me/919080553616"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center px-5 py-3 rounded bg-blue-600 text-white font-medium hover:bg-blue-700"
      >
        Get a Dental Cost Estimate
      </a>
    </section>
  </main>
</Layout>
