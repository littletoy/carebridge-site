---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
---

<Layout title="Hair Transplant in India | CareBridge Health">
  <Container>
    <div class="mt-16 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
        Premium FUE Hair Transplants<br>
        <span class="text-blue-600">at 70% Less Cost</span>
      </h1>
      <p class="text-lg mt-4 text-slate-600">
        Get full density hair restoration with ABHRS-certified surgeons in India. 
        Includes airport pickup, 5-star hotel, and lifetime warranty.
      </p>
      
      <div class="mt-8 flex justify-center gap-4">
        <a href="/book" class="bg-black text-white px-6 py-3 rounded-lg font-medium hover:bg-slate-800 transition">
          Book Video Consult
        </a>
        <a href="https://wa.me/919994581853" class="bg-green-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-700 transition flex items-center gap-2">
          <span>WhatsApp Quote</span>
        </a>
      </div>
    </div>

    <div class="mt-24">
      <h2 class="text-3xl font-bold text-center mb-10">Why India? The Price Difference</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100 text-slate-900">
              <th class="p-4 border-b-2 border-slate-200">Treatment</th>
              <th class="p-4 border-b-2 border-slate-200">USA / UK Cost</th>
              <th class="p-4 border-b-2 border-slate-200">Turkey Cost</th>
              <th class="p-4 border-b-2 border-blue-600 bg-blue-50 text-blue-800">CareBridge Network</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-4 border-b">FUE (2500 Grafts)</td>
              <td class="p-4 border-b text-red-600 font-medium">$12,000</td>
              <td class="p-4 border-b">$3,500</td>
              <td class="p-4 border-b font-bold text-green-700">$1,800</td>
            </tr>
            <tr>
              <td class="p-4 border-b">DHI (Direct Implant)</td>
              <td class="p-4 border-b text-red-600 font-medium">$15,000</td>
              <td class="p-4 border-b">$4,200</td>
              <td class="p-4 border-b font-bold text-green-700">$2,200</td>
            </tr>
            <tr>
              <td class="p-4 border-b">Surgeon Certification</td>
              <td class="p-4 border-b">Varies</td>
              <td class="p-4 border-b">Technician Often Does It</td>
              <td class="p-4 border-b font-bold">ABHRS Certified Doctor</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-24 grid md:grid-cols-2 gap-10 items-center">
      <div>
         <img 
          src="https://images.unsplash.com/photo-1581056771107-24ca5f033842?q=80&w=2070&auto=format&fit=crop" 
          alt="Doctor explaining procedure" 
          class="rounded-lg shadow-xl"
        />
      </div>
      <div>
        <h2 class="text-3xl font-bold text-slate-900 mb-6">Our 3-Day "Medical Holiday"</h2>
        <ul class="space-y-4">
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">1</span>
            <div>
              <strong class="block text-slate-900">Arrival & VIP Pickup</strong>
              <p class="text-slate-600">Our driver meets you at the airport and takes you to your 4-star hotel.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">2</span>
            <div>
              <strong class="block text-slate-900">Surgery Day (6-8 Hours)</strong>
              <p class="text-slate-600">Painless anesthesia. You watch Netflix while the doctor implants grafts.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">3</span>
            <div>
              <strong class="block text-slate-900">Wash & Sightseeing</strong>
              <p class="text-slate-600">Post-op checkup. Enjoy a local tour before your flight home.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="mt-24 mb-20">
      <h2 class="text-3xl font-bold text-center mb-4">Meet Our Exclusive Partners</h2>
      <p class="text-center text-slate-600 mb-12 max-w-2xl mx-auto">
        We do not use technicians. Your surgery is performed by India's Top 5 ABHRS Certified Surgeons.
      </p>

      <div class="grid md:grid-cols-3 gap-8">
        
        <div class="relative bg-white p-6 rounded-xl border-2 border-yellow-400 shadow-lg hover:shadow-xl transition transform hover:-translate-y-1 flex flex-col items-center">
          <div class="absolute top-0 right-0 bg-yellow-400 text-slate-900 text-xs font-bold px-3 py-1 rounded-bl-lg rounded-tr-lg">
            PRESIDENT, AHRS
          </div>
          <div class="w-24 h-24 bg-slate-200 rounded-full mb-4 overflow-hidden">
            <img src="https://ui-avatars.com/api/?name=Mayank+Singh&background=FCD34D&color=000&size=128&bold=true" alt="Dr Mayank Singh" class="w-full h-full object-cover"/>
          </div>
          <h3 class="text-xl font-bold text-center text-slate-900">Dr. Mayank Singh</h3>
          <p class="text-blue-600 text-sm font-bold text-center mb-4">Crown Clinic | New Delhi</p>
          <ul class="text-sm text-slate-600 space-y-2 mb-6 w-full text-left pl-4">
            <li class="flex gap-2"><span>🏆</span> <strong>President, AHRS India</strong></li>
            <li class="flex gap-2"><span>🇺🇸</span> Diplomate, ABHRS (USA)</li>
            <li class="flex gap-2"><span>🎓</span> M.Ch Plastic Surgery</li>
            <li class="flex gap-2"><span>✨</span> Specialist in Repair Cases</li>
          </ul>
          <a href="/book" class="block w-full py-2 bg-slate-900 text-white font-bold text-center rounded-lg hover:bg-slate-800 transition">
            Request Quote
          </a>
        </div>

        <div class="relative bg-white p-6 rounded-xl border border-slate-200 shadow-sm opacity-90 flex flex-col items-center">
             <div class="absolute top-0 right-0 bg-gray-200 text-slate-600 text-xs font-bold px-3 py-1 rounded-bl-lg rounded-tr-lg">
            JOINING SOON
          </div>
          <div class="w-24 h-24 bg-slate-200 rounded-full mb-4 overflow-hidden">
            <img src="https://ui-avatars.com/api/?name=Kapil+Dua&background=e2e8f0&color=64748b&size=128&bold=true" alt="Dr Kapil Dua" class="w-full h-full object-cover"/>
          </div>
          <h3 class="text-xl font-bold text-center text-slate-900">Dr. Kapil Dua</h3>
          <p class="text-blue-600 text-sm font-bold text-center mb-4">AK Clinics | New Delhi</p>
          <ul class="text-sm text-slate-600 space-y-2 mb-6 w-full text-left pl-4">
            <li class="flex gap-2"><span>🌍</span> ISHRS Board of Governors</li>
            <li class="flex gap-2"><span>🇺🇸</span> Diplomate, ABHRS (USA)</li>
            <li class="flex gap-2"><span>🎓</span> MBBS, MS (ENT)</li>
            <li class="flex gap-2"><span>✨</span> 10,000+ Surgeries</li>
          </ul>
          <button disabled class="block w-full py-2 border-2 border-slate-200 text-slate-400 font-bold text-center rounded-lg cursor-not-allowed">
            Activation Pending
          </button>
        </div>

        <div class="bg-slate-50 p-6 rounded-xl border border-dashed border-slate-300 flex flex-col justify-center items-center text-center">
          <div class="w-16 h-16 bg-slate-200 rounded-full mb-4 flex items-center justify-center text-2xl">
            🔒
          </div>
          <h3 class="text-lg font-bold text-slate-900">Premium Partner Slot</h3>
          <p class="text-sm text-slate-500 mt-2 mb-6">We are currently vetting surgeons in Mumbai & Bangalore.</p>
          <span class="text-xs bg-slate-200 px-3 py-1 rounded-full text-slate-600">Coming Soon</span>
        </div>

      </div>
    </div>

  </Container>
</Layout>