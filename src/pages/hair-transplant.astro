---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Hair Transplant in India – CareBridge Health">
  <main class="container mx-auto px-5 py-12 max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-bold mb-6">
      Hair Transplant & Hair Restoration in India
    </h1>

    <p class="text-slate-600 text-lg mb-8">
      CareBridge Health helps international patients access world-class hair
      transplant centres in India, with transparent pricing and end-to-end
      coordination – from online consultation to post-procedure follow-up.
    </p>

    <section class="mb-10 space-y-4">
      <h2 class="text-2xl font-semibold">Techniques We Coordinate</h2>
      <ul class="list-disc list-inside space-y-2 text-slate-600">
        <li>FUE (Follicular Unit Extraction) hair transplant</li>
        <li>FUT / Strip method (for selected cases)</li>
        <li>Beard, moustache and eyebrow transplants</li>
        <li>PRP therapy as a supportive treatment</li>
      </ul>
    </section>

    <section class="mb-10 space-y-4">
      <h2 class="text-2xl font-semibold">Who Is This For?</h2>
      <ul class="list-disc list-inside space-y-2 text-slate-600">
        <li>Men and women with pattern baldness or thinning hair</li>
        <li>Patients who previously had transplant with poor density</li>
        <li>People looking for premium results at lower cost than US/UK/UAE</li>
      </ul>
    </section>

    <section class="mb-10 space-y-4">
      <h2 class="text-2xl font-semibold">Typical Treatment Journey</h2>
      <ol class="list-decimal list-inside space-y-2 text-slate-600">
        <li>Share photos & medical history for initial assessment</li>
        <li>Video consultation with a hair transplant specialist</li>
        <li>Personalised graft estimate and cost transparency</li>
        <li>Travel, stay and hospital coordination by our team</li>
        <li>Procedure day + immediate after-care</li>
        <li>Online follow-ups for 12 months</li>
      </ol>
    </section>

    <section class="bg-slate-50 rounded-xl p-6 mt-4">
      <h2 class="text-xl font-semibold mb-3">Get a Free Hair Evaluation</h2>
      <p class="text-slate-600 mb-4">
        Send us your scalp photos and we’ll arrange a free opinion from a
        partner hair transplant surgeon in India.
      </p>
      <a
        href="https://wa.me/919080553616"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center px-5 py-3 rounded bg-blue-600 text-white font-medium hover:bg-blue-700"
      >
        Share Photos via WhatsApp
      </a>
    </section>
  </main>
</Layout>
