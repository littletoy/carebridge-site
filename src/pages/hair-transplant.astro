---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
---

<Layout title="Hair Transplant in India | CareBridge Health">
  <Container>
    <div class="mt-16 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-900">
        Premium FUE Hair Transplants<br>
        <span class="text-blue-600">at 70% Less Cost</span>
      </h1>
      <p class="text-lg mt-4 text-slate-600">
        Get full density hair restoration with ABHRS-certified surgeons in India. 
        Includes airport pickup, 5-star hotel, and lifetime warranty.
      </p>
      
      <div class="mt-8 flex justify-center gap-4">
        <a href="/book" class="bg-black text-white px-6 py-3 rounded-lg font-medium hover:bg-slate-800 transition">
          Book Video Consult
        </a>
        <a href="https://wa.me/919994581853" class="bg-green-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-700 transition flex items-center gap-2">
          <span>WhatsApp Quote</span>
        </a>
      </div>
    </div>

    <div class="mt-24">
      <h2 class="text-3xl font-bold text-center mb-10">Why India? The Price Difference</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-100 text-slate-900">
              <th class="p-4 border-b-2 border-slate-200">Treatment</th>
              <th class="p-4 border-b-2 border-slate-200">USA / UK Cost</th>
              <th class="p-4 border-b-2 border-slate-200">Turkey Cost</th>
              <th class="p-4 border-b-2 border-blue-600 bg-blue-50 text-blue-800">CareBridge India</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-4 border-b">FUE (2500 Grafts)</td>
              <td class="p-4 border-b text-red-600 font-medium">$12,000</td>
              <td class="p-4 border-b">$3,500</td>
              <td class="p-4 border-b font-bold text-green-700">$1,800</td>
            </tr>
            <tr>
              <td class="p-4 border-b">DHI (Direct Implant)</td>
              <td class="p-4 border-b text-red-600 font-medium">$15,000</td>
              <td class="p-4 border-b">$4,200</td>
              <td class="p-4 border-b font-bold text-green-700">$2,200</td>
            </tr>
            <tr>
              <td class="p-4 border-b">Surgeon Certification</td>
              <td class="p-4 border-b">Varies</td>
              <td class="p-4 border-b">Technician Often Does It</td>
              <td class="p-4 border-b font-bold">ABHRS Certified Doctor</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-24 grid md:grid-cols-2 gap-10 items-center">
      <div>
         <img 
          src="https://images.unsplash.com/photo-1581056771107-24ca5f033842?q=80&w=2070&auto=format&fit=crop" 
          alt="Doctor explaining procedure" 
          class="rounded-lg shadow-xl"
        />
      </div>
      <div>
        <h2 class="text-3xl font-bold text-slate-900 mb-6">Our 3-Day "Medical Holiday"</h2>
        <ul class="space-y-4">
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">1</span>
            <div>
              <strong class="block text-slate-900">Arrival & VIP Pickup</strong>
              <p class="text-slate-600">Our driver meets you at the airport and takes you to your 4-star hotel.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">2</span>
            <div>
              <strong class="block text-slate-900">Surgery Day (6-8 Hours)</strong>
              <p class="text-slate-600">Painless anesthesia. You watch Netflix while the doctor implants grafts.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">3</span>
            <div>
              <strong class="block text-slate-900">Wash & Sightseeing</strong>
              <p class="text-slate-600">Post-op checkup. Enjoy a local tour before your flight home.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
    
  </Container>
</Layout>