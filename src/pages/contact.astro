---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact CareBridge Health – Free Treatment Quote">
  <main class="container mx-auto px-5 py-12 max-w-3xl">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
      Contact CareBridge Health
    </h1>
    <p class="text-slate-600 mb-8">
      Share a few details and our team will get back to you within 24 hours
      with treatment options, hospital suggestions, and an estimated cost.
    </p>

    <form
      action="https://formspree.io/f/xojvrood"
      method="POST"
      class="bg-white rounded-2xl shadow-lg p-6 md:p-8 space-y-5"
    >
      <!-- Hidden fields -->
      <input
        type="hidden"
        name="_subject"
        value="New enquiry from CareBridge Health website"
      />
      <!-- optional: where to redirect after success -->
      <!-- <input type="hidden" name="_redirect" value="https://carebridge-health.com/thank-you" /> -->

      <div class="grid md:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1" for="name">
            Full Name
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            placeholder="John Doe"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1" for="country">
            Country
          </label>
          <input
            id="country"
            name="country"
            type="text"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            placeholder="UAE, UK, USA, etc."
          />
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1" for="email">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            placeholder="you@example.com"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1" for="phone">
            WhatsApp Number
          </label>
          <input
            id="phone"
            name="phone"
            type="tel"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            placeholder="+971 50 000 0000"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="treatment">
          Treatment Type
        </label>
        <select
          id="treatment"
          name="treatment"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Select treatment</option>
          <option>Hair Transplant</option>
          <option>Dental Implants / Smile Makeover</option>
          <option>Cosmetic / Plastic Surgery</option>
          <option>Other</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="message">
          Medical Details / Question
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="Short history, reports, what treatment you are looking for…"
        ></textarea>
      </div>

      <!-- simple spam trap (Formspree honey pot) -->
      <div class="hidden">
        <label>
          Don’t fill this out if you’re human:
          <input name="_gotcha" type="text" />
        </label>
      </div>

      <button
        type="submit"
        class="w-full md:w-auto inline-flex justify-center items-center px-6 py-3 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-500"
      >
        Submit Enquiry
      </button>

      <p class="text-xs text-slate-400">
        By submitting, you agree to be contacted by CareBridge Health over email or
        WhatsApp regarding your enquiry.
      </p>
    </form>
  </main>
</Layout>
