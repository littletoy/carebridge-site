---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
---

<Layout title="Contact Us | CareBridge Health">
  <Container>
    <div class="mt-16 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-slate-900">Get in Touch</h1>
      <p class="text-lg mt-4 text-slate-600">
        We are based in Tamil Nadu, India, but we serve patients globally.
      </p>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-10 max-w-4xl mx-auto mb-20">
      <div class="bg-slate-50 p-8 rounded-xl text-center">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Fastest Response</h2>
        <p class="text-slate-600 mb-6">For quotes and medical questions, WhatsApp is best.</p>
        <a href="https://wa.me/919840653616" class="inline-block bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition">
          Chat on WhatsApp
        </a>
      </div>

      <div class="bg-slate-50 p-8 rounded-xl text-center">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Email Us</h2>
        <p class="text-slate-600 mb-6">Send your medical reports or X-rays for review.</p>
        <a href="mailto:support@carebridge-health.com" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
          support@carebridge-health.com
        </a>
      </div>
    </div>
  </Container>
</Layout>