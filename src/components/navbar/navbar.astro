---
/* No imports needed */
---

<header class="sticky top-0 z-50 border-b bg-white/80 backdrop-blur">
  <nav class="container mx-auto flex items-center justify-between gap-4 px-4 py-3">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img
        src="/logo.png"
        alt="CareBridge Health logo"
        class="h-8 w-auto"
        loading="lazy"
      />
      <span class="font-semibold text-lg tracking-tight">
        CareBridge
      </span>
    </a>

    <!-- Links + WhatsApp -->
    <div class="flex items-center gap-4">
      <!-- NAV LINKS: visible on ALL screen sizes -->
      <div
        class="flex flex-wrap items-center justify-center gap-3 text-sm font-medium text-slate-700 md:gap-6 md:text-base"
      >
        <a href="/" class="hover:text-blue-600">Home</a>
        <a href="/hair-transplant" class="hover:text-blue-600">
          Hair Transplant
        </a>
        <a href="/dental" class="hover:text-blue-600">Dental</a>
        <a href="/cosmetic" class="hover:text-blue-600">Cosmetic</a>
        <a href="/about" class="hover:text-blue-600">About Us</a>
      </div>

      <!-- WhatsApp button (hide only on very small screens if it feels cramped) -->
      <a
        href="https://wa.me/919080553616"
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
      >
        Chat on WhatsApp
      </a>
    </div>
  </nav>
</header>
