---
import Container from "../container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  { href: "/", label: "Home" },
  { href: "/india", label: "India VIP Care", highlight: true }, // Added the new VIP page here
  { href: "/hair-transplant", label: "Hair Transplant" },
  { href: "/dental", label: "Dental" },
  { href: "/cosmetic", label: "Cosmetic" },
  { href: "/blog", label: "Guide" },
  { href: "/book", label: "Book Call" },
  { href: "/about", label: "About Us" },
  { href: "/contact", label: "Contact" },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo.png" alt="CareBridge Health" class="h-14 w-auto" />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-8 h-8 text-slate-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.href}
                      class={`flex lg:px-3 py-2 items-center font-medium transition ${
                        item.highlight
                          ? "text-emerald-600 font-bold hover:text-emerald-700" // Special styling for the VIP link
                          : "text-slate-600 hover:text-blue-600"
                      }`}
                    >
                      {item.label}
                      {/* Add a tiny VIP badge if it's the highlighted item */}
                      {item.highlight && (
                        <span class="ml-2 bg-emerald-100 text-emerald-700 text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider">
                          VIP
                        </span>
                      )}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <a href="https://wa.me/919840653616" class="px-4 py-2 rounded text-white bg-blue-600 hover:bg-blue-700 w-full text-center">
             Chat on WhatsApp
          </a>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a href="https://wa.me/919840653616" class="px-6 py-2 rounded-lg text-white bg-blue-600 hover:bg-blue-700 font-bold transition shadow-lg shadow-blue-600/20">
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </header>
</Container>