---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/hair-transplant", label: "Hair Transplant" },
  { href: "/dental", label: "Dental" },
  { href: "/cosmetic", label: "Cosmetic" },
  { href: "/about", label: "About Us" },
];
---

<header class="border-b border-slate-100 bg-white">
  <nav class="container mx-auto flex items-center justify-between px-5 py-4">
    <!-- Logo + brand -->
    <a href="/" class="flex items-center gap-2">
      <img
        src="/logo.png"
        alt="CareBridge Health logo"
        class="h-8 w-auto"
        loading="lazy"
      />
      <span class="font-semibold text-lg text-slate-900">CareBridge</span>
    </a>

    <!-- Nav links -->
    <div class="flex items-center gap-6">
      <ul class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-700">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="hover:text-slate-900"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- WhatsApp CTA -->
      <a
        href="https://wa.me/919080553616"
        target="_blank"
        rel="noopener"
        class="rounded text-sm font-semibold px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 transition"
      >
        Chat on WhatsApp
      </a>
    </div>
  </nav>
</header>
